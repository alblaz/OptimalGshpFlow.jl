@Article{claesson2018explicit,
author={Claesson, Johan
and Javed, Saqib},
title={Explicit Multipole Formulas for Calculating Thermal Resistance of Single U-Tube Ground Heat Exchangers},
journal={Energies},
year={2018},
volume={11},
keywords={formulas; second-order; U Tube; calculation; ground heat exchanger},
abstract={Borehole thermal resistance is both an important design parameter and a key performance characteristic of a ground heat exchanger. Another quantity that is particularly important for ground heat exchangers is the internal thermal resistance between the heat exchanger pipes. Both these resistances can be calculated to a high degree of accuracy by means of the well-known multipole method. However, the multipole method has a fairly intricate mathematical algorithm and is thus not trivial to implement. Consequently, there is considerable interest in developing explicit formulas for calculating borehole resistances. This paper presents derivation and solutions of newly derived second-order and higher-order multipole formulas for calculating borehole thermal resistance and total internal thermal resistance of single U-tube ground heat exchangers. A new and simple form of the first-order multipole formula is also presented. The accuracy of the presented formulas is established by comparing them to the original multipole method. The superiority of the new higher-order multipole formulas over the existing formulas is also demonstrated.},
note={B. Participants: 72 studied cases with varying grout and soil conductivities.},
note={B1. Young [17] compared the tenth-order multipole method with a boundary-fitted coordinates finite volume methods for 18 combinations of shank spacing and grout conductivities, and observed a maximum difference of 0.26{\%} between the two methods. Lamarche et al [12] calculated a root-mean-square difference of 0.003 between the first-order multipole method and a finite element numerical model for 72 studied cases with varying grout and soil conductivities, and pipe sizes and positing. He [18] studied four cases of different borehole diameters and grout conductivities using a three-dimensional numerical model and the multipole method, and reported a maximum difference of.},
note={C. Highlights.},
note={C1. The use of ground source heat pump (GSHP) systems to provide heating and cooling in buildings has increased at a rapid rate in the last two decades or so.},
note={C2. This paper has presented new second-order and third-order multipole formulas for calculating.},
note={C3. This paper has presented new second-order and third-order multipole formulas for calculating borehole thermal resistance and total internal thermal resistance.},
note={C4. The newly derived formulas can used for all single U-tube applications where the two legs of the U-tube are symmetrically placed in be used for all single U-tube applications where the two legs of the U-tube are symmetrically placed the borehole.},
note={C5. The presented formulas have been compared with the original multipole method, as in the borehole.},
note={C6. The results shown in these figures are for a single ground thermal conductivity of 4.0 W/m-K.},
note={C7. The presented formulas have been compared with the original multipole method, well as the previously derived zeroth-order and first-order explicit multipole formulas.},
note={D. Findings.},
note={D1. The results shown in these figures are for a single ground thermal conductivity of 4.0 W/m-K.},
note={D2. The results shown in these resistance.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. This paper presents the derivation and solutions of new second-order and higher-order multipole formulas for calculating borehole thermal resistance of single U-tube ground heat exchangers with symmetric pipes, which can be used to improve the design and performance of ground source heat pump systems..},
note={E3. Key findings.},
note={E4. The new multipole formulas presented in the paper are more accurate and simpler to implement than existing formulas, and can be used to calculate borehole thermal resistance and total internal thermal resistance of single U-tube ground heat exchangers..},
note={E5. The study finds that the multipole factors for the two pipes depend on the prescribed heat fluxes, and the temperature field is symmetric in x for equal heat fluxes and odd in x for antisymmetric heat fluxes. The multipoles of pipe 2 are closely related to the multipoles of pipe 1 in the even and odd cases..},
note={E6. The second-order and third-order multipole formulas provide higher accuracy than the zeroth-order and first-order multipole formulas for calculating borehole thermal resistance and total internal thermal resistance. The grout thermal resistance values obtained from the second-order and third-order multipole formulas are within 0.5{\%} and 0.2{\%} of the tenth-order multipole method for all 216 cases..},
note={E7. The key findings of the study include the development of new second-order and third-order multipole formulas that provide significant accuracy improvements over previous methods. The study also finds that the second-order multipole formulas are more straightforward to use and are recommended for use in practice..},
note={E8. The presented formulas have been compared with the original multipole method, well as the previously derived zeroth-order and first-order explicit multipole formulas.},
note={E9. Objectives.},
note={E10. The main objective of the study is to present a very precise method to calculate the relations between heat flows and fluid temperatures in a grouted borehole with multiple pipes. The study aims to determine the thermal resistance of the borehole, which is critical to understanding the effective borehole thermal resistance..},
note={E11. Methods.},
note={E12. The multipole method is an analytical method used to determine thermal resistances for any number of arbitrarily placed pipes in a composite region, and is based on two-dimensional steady-state conductive heat transfer in a borehole. The method is simplified by assuming that heat exchanger pipes are placed symmetrically about the center of the borehole..},
note={E13. The study uses a multipole method to determine the thermal resistance of the borehole. The method involves solving a set of equations for the multipole factors, which depend on the prescribed heat fluxes. The study also uses a dimensionless parameter $\beta$ to represent the thermal resistance and a parameter $\sigma$ to represent the ratio between the two conductivities..},
note={E14. The study uses a reference dataset provided by [13] to compare and benchmark the borehole thermal resistance estimations from different analytical methods. The study involves the development of new higher-order multipole formulas and their comparison to previously published results..},
note={E15. The methods used in the study include the derivation of new second-order and third-order multipole formulas. The study also uses comparisons with the original multipole method and previously derived zeroth-order and first-order explicit multipole formulas to evaluate the accuracy of the new formulas..},
note={E16. Results.},
note={E17. The new multipole formulas are tested against the original multipole method and previously-derived zeroth-order and first-order multipole formulas, and are shown to be more accurate and simpler to implement..},
note={E18. The study finds that the thermal resistances depend on the choice of the number of multipoles J, and the accuracy increases rapidly with increasing J. The study also determines the required fluid temperatures for unit heat flux, which are obtained from the multipole solutions..},
note={E19. The results show that the second-order and third-order multipole formulas provide higher accuracy than the zeroth-order and first-order multipole formulas. The mean absolute percentage error of the results obtained from the second-order and third-order multipole formulas never exceed 0.4{\%} and 0.1{\%}, respectively..},
note={E20. The results of the study show that the new second-order and third-order multipole formulas provide significant accuracy improvements over previous methods. The results also show that the second-order multipole formulas are more straightforward to use and are recommended for use in practice..},
note={E21. Conclusions.},
note={E22. The new multipole formulas presented in the paper can be used to improve the design and performance of ground source heat pump systems by providing more accurate calculations of borehole thermal resistance and total internal thermal resistance..},
note={E23. The study concludes that the multipole method is a precise way to calculate the relations between heat flows and fluid temperatures in a grouted borehole with multiple pipes. The study also highlights the importance of considering the thermal resistance of the borehole in understanding the effective borehole thermal resistance..},
note={E24. The study concludes that the new higher-order multipole formulas provide significant improvements in accuracy for calculating borehole thermal resistance and total internal thermal resistance. The second-order and third-order multipole formulas are simple enough to apply for computation purposes..},
note={E25. The conclusions of the study include the recommendation of the new second-order multipole formulas for use in practice due to their excellent accuracy and relative ease of implementation. The study also concludes that the new formulas can be used for all single U-tube applications where the two legs of the U-tube are symmetrically placed in the borehole.},
doi={10.3390/en11010214},
url={https://doi.org/10.3390/en11010214}
}

