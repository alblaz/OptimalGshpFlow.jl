@Article{edwards2015generalised,
author={Edwards, K. C.
and Finn, Donal},
title={Generalised water flow rate control strategy for optimal part load operation of ground source heat pump systems},
journal={Applied Energy},
year={2015},
volume={150},
keywords={coefficient of performance; Optimal; COP3; Control; Ground source heat pumps; control strategy},
abstract={A control strategy was developed to predict optimal ground source heat pump water flow rates under part load operation. Using this strategy, optimal flow rates are calculated from available design data and minimal on-line measurements. The optimal control strategy was evaluated with validated single speed and tandem speed ground source heat pump simulation models in both heating and cooling mode. A range of building load profiles were implemented when analysing heat pump system performance. The optimal strategy was shown to result in an improvement in system performance when compared to nominal flow rate operation, particularly for low load conditions. Due to the prevalence of low load operation over a heating or cooling season, the seasonal system performance (SPF3) was shown to increase by between 20{\%} and 40{\%} when using the optimal strategy.},
note={C. Highlights.},
note={C1. The optimal control strategy is analysed in quasi-steady state using the building simulation models.},
note={C2. The developed control strategy predicts steady state optimal internal and external circuit water flow rate, which is used to estimate optimal part load flow rate depending on current load conditions.},
note={C3. In steady state, the optimal control strategy results in COP3 values close to the simulated maximum over a range of tested part loads. In both steady and quasi-steady state the optimal strategy produces a significant improvement in COP3 when compared to nominal pump frequency operation, for low part load conditions.},
note={C4. This translates to an increase in SPF3 of over 20{\%} in heating and 40{\%} in cooling when the optimal control strategy is implemented over nominal frequency operation, as the system experiences low part load conditions for the majority of a season.},
note={C5. This simulation study demonstrates the performance improvements possible using the optimal flow rate control strategy, which will be evaluated in future work through experimental trials.},
note={D. Findings.},
note={D1. Due to the prevalence of low load operation over a heating or cooling season, the seasonal system performance (SPF3) was shown to increase by between 20{\%} and 40{\%} when using the optimal strategy.},
note={D2. The Carnot efficiency can be affected by up to 1{\%} per K, giving kEF a value of {\`A}0.01 or less.},
note={D3. The reduction in COP3 from the simulated maximum is less than 1{\%} when using the optimal strategy.},
note={D4. COP3 decreases significantly, by up to 60{\%}, when using the nominal frequency for decreasing part loads.},
note={D5. flow control is implemented over the nominal pump frequency. This increases to 38{\%} and 40{\%} for the single and tandem speed heat pumps in cooling mode.},
note={D6. However, in steady state, the optimal control strategy results in COP3 values close to the simulated maximum over a range of tested part loads. In both steady and quasi-steady state the optimal strategy produces a significant improvement in COP3 when compared to nominal pump frequency operation, particularly for low part load conditions. This translates to an increase in SPF3 of over 20{\%} in heating and 40{\%} in cooling when the optimal control strategy is implemented over nominal frequency operation, as the system experiences low part load conditions for the majority of a season.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The optimal flow rate control strategy for heat pumps is evaluated, showing significant improvements in COP3 and SPF3 compared to nominal pump frequency operation, particularly for low part load conditions..},
note={E3. Key findings.},
note={E4. The key findings of the study include the development of a control strategy that can predict optimal ground source heat pump water flow rates under part load operation, resulting in an improvement in system performance of between 20{\%} and 40{\%}. The study also found that the optimal flow rate varies non-linearly with capacity, and that the internal and external flow rates can be optimized independently while still achieving system optimization..},
note={E5. The optimal internal water flow rate decreases as the part load decreases, while the optimal external water flow rate remains relatively constant. The COP at part load conditions can be calculated using equations that take into account the steady state performance, power fraction, and capacity fraction..},
note={E6. The key findings include the optimal control strategy resulting in COP3 values close to the simulated maximum over a range of tested part loads, and significant improvements in SPF3 of over 20{\%} in heating and 40{\%} in cooling when compared to nominal pump frequency operation..},
note={E7. This translates to an increase in SPF3 of over 20{\%} in heating and 40{\%} in cooling when the optimal control strategy is implemented over nominal frequency operation, as the system experiences low part load conditions for the majority of a season.},
note={E8. This simulation study demonstrates the performance improvements possible using the optimal flow rate control strategy, which will be evaluated in future work through experimental trials.},
note={E9. Objectives.},
note={E10. The objective of the study was to develop a control strategy for optimizing internal and external water flow rate under part load conditions, with the goal of improving the seasonal performance of ground source heat pump systems. The study aimed to address the issue of optimal water flow control for fixed speed heat pump systems under part load conditions, which had received little attention in previous research..},
note={E11. Methods.},
note={E12. The study used a combination of analytical and empirical methods to develop a simulation model of a ground source heat pump system. The study also used regression fitting techniques to generate multi-variant correlation curves, and combined the component models into quasi-steady state system models in MATLAB. The study evaluated the control strategy using validated simulation models of single speed and tandem speed ground source heat pump systems in both heating and cooling mode..},
note={E13. The study uses a combination of theoretical analysis and simulation to derive the analytical equations for calculating the optimal internal and external water flow rates. The equations are based on the steady state performance, power fraction, and capacity fraction, and take into account the part load, internal water flow rate, and design parameters..},
note={E14. The methods used include simulations using building simulation models, comparing the optimal flow rate control strategy to nominal pump frequency operation, and evaluating the results in terms of COP3 and SPF3..},
note={E15. Results.},
note={E16. The results of the study showed that the optimal control strategy resulted in an improvement in system performance when compared to nominal flow rate operation, particularly for low load conditions. The study found that the seasonal system performance (SPF3) increased by between 20{\%} and 40{\%} when using the optimal strategy. The study also found that the internal and external flow rates can be optimized independently while still achieving system optimization..},
note={E17. The study shows that the optimal internal water flow rate can be calculated using equations that take into account the part load, internal water flow rate, and design parameters. The results also show that the optimal external water flow rate remains relatively constant, and can be adjusted linearly between the estimated optimal 'mode 1' and 'mode 2' steady state flow rate as the part load moves from 0.5 to 1..},
note={E18. The results show that the optimal control strategy results in COP3 values close to the simulated maximum over a range of tested part loads, and significant improvements in SPF3 of over 20{\%} in heating and 40{\%} in cooling when compared to nominal pump frequency operation..},
note={E19. Conclusions.},
note={E20. The study concluded that the developed control strategy can predict optimal ground source heat pump water flow rates under part load operation, resulting in an improvement in system performance of between 20{\%} and 40{\%}. The study also concluded that the optimal flow rate varies non-linearly with capacity, and that the internal and external flow rates can be optimized independently while still achieving system optimization..},
note={E21. The study concludes that the optimal internal and external water flow rates for a heat pump system can be determined using analytical equations, which can help maximize the COP at part load conditions. The results can be used to develop a control strategy for optimizing the performance of heat pump systems..},
note={E22. The conclusions drawn from the study are that the optimal flow rate control strategy shows significant improvements in COP3 and SPF3 compared to nominal pump frequency operation, particularly for low part load conditions, and that this strategy has the potential to be implemented in real-world applications.},
doi={10.1016/j.apenergy.2015.03.134},
url={https://doi.org/10.1016/j.apenergy.2015.03.134}
}

@Article{corberan2010quasi,
author={Corber{\'a}n, Jos{\'e} M.
and Finn, Donal
and Montagud, Carla
and Murphy, Fionnuala
and Edwards, K. C.},
title={A quasi-steady state mathematical model of an integrated ground source heat pump for building space control},
journal={Energy and Buildings},
year={2010},
volume={43},
keywords={Ground source heat pump; Mathematical model; Engineering Equation Solver; steady state},
abstract={This paper is concerned with the development of a mathematical model, capable of describing the quasisteady state performance of an integrated ground source heat pump, which is used for heating and cooling of an institutional building located in a Mediterranean climate. The model is structured on functional basis according to the heat pump vapour compression or primary circuit, a secondary ground loop circuit and a secondary building loop circuit. Heat pump heating and cooling capacities, as well as COP, are considered to be dependent variables and are estimated in the model using performance fitted maps. Independent variables include: compressor speed, circulation pump speeds, ground loop return temperature and building circuit return temperature. The model is validated using data from a full-scale ground source heat pump installation. The validated model is used to examine system capacity and performance sensitivity to different control optimisation strategies, including set-point control of room air temperature, room air bandwidth temperature, building loop return water temperature and building loop return bandwidth temperature.},
note={C. Highlights.},
note={C1. Research concerning control issues related to vapour compression systems has largely focused on refrigeration and air-conditioning and to a lesser extent on heat pumps.},
note={C2. This paper examines, for a ground source heat pump (GSHP), how control of building circuit variables affects overall system performance.},
note={C3. A system level mathematical model was developed from the GSHP heat pump system using Engineering Equation Solver (EES) [17].},
note={C4. The vapour compression software package IMST-ART was used to model the behaviour of the GSHP as a standalone system [18].},
note={C5. This paper examines, for ground source heat pumps, how control of building circuit variables affects overall system performance.},
note={C6. It would appear that higher water return temperatures reduces the ON time operation of the heat pump, and results in an increase of daily heat pump seasonal performance factor (SPF) of approximately 5{\%} per each degree increase of the building water return temperature.},
note={D. Findings.},
note={D1. As can be observed on the right hand axes of Figs. 3--5, experimental measurements for cooling capacity and power input are predicted by the polynomial correlations with a maximum mean deviation better than 5{\%} for cooling capacity and 2.4{\%} for power input.},
note={D2. Analysis shows that capacity increases by approximately 3.6{\%} per degree increase of the building return water temperature.},
note={D3. Values for the SPF of the system and the heat pump are affected by less than 0.5{\%} by return water temperature bandwidth.},
note={D4. Values for the SPF of the system and the heat pump are slightly affected, less than 1{\%}, by space temperature bandwidth.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. This paper presents a quasi-steady state mathematical model of an integrated ground source heat pump for building space control, which is validated using data from a full-scale ground source heat pump installation and used to examine system capacity and performance sensitivity to different control optimisation strategies..},
note={E3. Key findings.},
note={E4. The model is validated using data from a full-scale ground source heat pump installation and is used to examine system capacity and performance sensitivity to different control optimisation strategies. The study finds that the ground source heat pump system offers relatively constant operating parameters for short-term measurements, insuring a smaller temperature difference between the condenser and evaporator..},
note={E5. The study found that the developed mathematical model accurately predicted the GSHP system's performance, with a maximum mean deviation of 5{\%} for cooling capacity and 2.4{\%} for power input in cooling mode, and 13.8{\%} for heating mode. The model also identified the importance of considering the thermal inertia of the evaporator and the hydronic loop in the system's performance..},
note={E6. The key findings of the study include the significant impact of space set-point temperature on system power consumption, with a decrease in power consumption as the set-point temperature increases. Additionally, the study found that building water return temperature has a lesser influence on system power consumption, but still results in a decrease in compressor power consumption and an increase in daily heat pump SPF as the water return temperature increases..},
note={E7. There are no key findings mentioned in the text regarding the influence of factors on overall system performance..},
note={E8. It would appear that higher water return temperatures reduces the ON time operation of the heat pump, and results in an increase of daily heat pump seasonal performance factor (SPF) of approximately 5{\%} per each degree increase of the building water return temperature.},
note={E9. Objectives.},
note={E10. The objective of the study is to develop a mathematical model of an integrated ground source heat pump for building space control and to examine system capacity and performance sensitivity to different control optimisation strategies. The study aims to investigate the role of various building circuit variables on the overall system performance..},
note={E11. Methods.},
note={E12. The study uses a system level mathematical model developed from the GSHP heat pump system using Engineering Equation Solver (EES). The vapour compression software package IMST-ART is used to model the behaviour of the GSHP as a standalone system. The model is validated using experimental data from the full-scale ground source heat pump installation..},
note={E13. The study used a combination of experimental and modeling approaches. The experimental data was used to develop correlations for heating and cooling mode, and to validate the mathematical model. The mathematical model was developed using Engineering Equation Solver and included sub-models for the heat pump, fan coils, circulation pumps, hydronic pipe network, storage tank, and building conditioned space..},
note={E14. The study uses a system mathematical model developed using Engineering Equation Solver to assess the impact of various building circuit variables on ground source heat pump performance..},
note={E15. Results.},
note={E16. The study finds that the validated model can be used to examine system capacity and performance sensitivity to different control optimisation strategies. The results show that the ground source heat pump system offers relatively constant operating parameters for short-term measurements..},
note={E17. The study found that the developed mathematical model accurately predicted the GSHP system's performance, with a maximum mean deviation of 5{\%} for cooling capacity and 2.4{\%} for power input in cooling mode, and 13.8{\%} for heating mode. The model also identified the importance of considering the thermal inertia of the evaporator and the hydronic loop in the system's performance..},
note={E18. The results of the study show that space set-point temperature has the most significant effect on system power consumption, with a decrease in power consumption as the set-point temperature increases. The results also show that building water return temperature has a lesser influence on system power consumption, but still results in a decrease in compressor power consumption and an increase in daily heat pump SPF as the water return temperature increases..},
note={E19. There are no results mentioned in the text regarding the influence of factors on overall system performance..},
note={E20. Conclusions.},
note={E21. The study concludes that the developed mathematical model can be used to examine system capacity and performance sensitivity to different control optimisation strategies. The study highlights the importance of considering the role of various building circuit variables on the overall system performance..},
note={E22. The study concluded that the developed mathematical model is a useful tool for optimizing and controlling GSHP systems. The model can be used to predict the system's performance and identify areas for improvement..},
note={E23. The study concludes that space set-point temperature has the most significant effect on system power consumption, and that building water return temperature has a lesser influence on system power consumption. The study also concludes that building water return bandwidth and space temperature bandwidth have a negligible effect on system performance..},
note={E24. The conclusions that can be drawn from the text are limited, as the influence of certain factors on overall system performance was not explored.},
doi={10.1016/j.enbuild.2010.08.017},
url={https://doi.org/10.1016/j.enbuild.2010.08.017}
}

@Article{de2011optimal,
author={De Ridder, Fjo
and Diehl, Moritz
and Mulder, Grietus
and Desmedt, Johan
and Van Bael, Johan},
title={An optimal control algorithm for borehole thermal energy storage systems},
journal={Energy and Buildings},
year={2011},
volume={43},
keywords={Optimal control; dynamic programming; HVAC; heat flux},
abstract={The aim of this paper is to present an optimal control algorithm to manage borehole thermal energy storage systems (BTES). Such a system gets exhausted, if it is employed intensively, i.e. outlet fluid is outside acceptable temperature ranges, and can no longer provide the desired heat or cold. To avoid this problem a control algorithm is proposed, which simultaneously optimizes the operation costs. This algorithm is based on a dynamic programming technique and results in an array which provides the optimal heat flux for a given field temperature, date and demand. The controller is illustrated on a simulation of an existing building. Several weather scenarios have been examined and the system remained robust under all situations.},
note={C. Highlights.},
note={C1. The aim of this paper is to present an optimal control algorithm to manage borehole thermal energy storage systems (BTES).},
note={C2. Such a system gets exhausted, if it is employed intensively, i.e. outlet fluid is outside acceptable temperature ranges, and can no longer provide the desired heat or cold. To avoid this problem a control algorithm is proposed, which simultaneously optimizes the operation costs. This algorithm is based on a dynamic programming technique and results in an array which provides the optimal heat flux for a given field temperature, date and demand.},
note={C3. A dynamic programming controller is able to operate the system within a given set of constraints.},
note={C4. The uncontrolled BTES installation operates at a lower cost.},
note={D. Findings.},
note={D1. In most buildings more than 40{\%} of the energy consumed is used for heating and cooling purposes.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study presents a dynamic programming approach to optimize the control of a ground heat storage system, taking into account various constraints such as pump capacity, temperature limits, and heat supply demands, to minimize costs and ensure a reliable heat and cold supply..},
note={E3. Key findings.},
note={E4. The optimal control algorithm is based on a dynamic programming technique and results in an array that provides the optimal heat flux for a given field temperature, date, and demand. The algorithm can cope with weather uncertainty and allows for off-line computations, facilitating the actual installation of the controller..},
note={E5. The study finds that the dynamic programming approach can effectively optimize the control of the ground heat storage system, taking into account various constraints such as pump capacity, temperature limits, and heat supply demands. The study also finds that the optimal control policy depends on the temperature of the field, the demand for heat or cold, and the time of year. The study concludes that the dynamic programming approach can help to minimize costs and ensure a reliable heat and cold supply..},
note={E6. Such a system gets exhausted, if it is employed intensively, i.e. outlet fluid is outside acceptable temperature ranges, and can no longer provide the desired heat or cold. To avoid this problem a control algorithm is proposed, which simultaneously optimizes the operation costs. This algorithm is based on a dynamic programming technique and results in an array which provides the optimal heat flux for a given field temperature, date and demand.},
note={E7. A dynamic programming controller is able to operate the system within a given set of constraints.},
note={E8. The uncontrolled BTES installation operates at a lower cost.},
note={E9. Objectives.},
note={E10. The objective of the study is to optimize the control of a ground heat storage system to minimize costs and ensure a reliable heat and cold supply. The study aims to develop a dynamic programming approach that takes into account various constraints such as pump capacity, temperature limits, and heat supply demands. The study also aims to evaluate the performance of the dynamic programming approach and compare it with other control strategies..},
note={E11. Methods.},
note={E12. The algorithm uses a dynamic programming approach to optimize the operation of the borehole thermal energy storage system. A first-order response model is used to describe the dynamics of the underground storage system..},
note={E13. The study uses a dynamic programming approach to optimize the control of the ground heat storage system. The approach involves discretizing time into weekly steps and dividing the demand and delivered heat or cold into intervals. The study also uses a cost function to evaluate the performance of the control policy. The cost function takes into account the cost of operating the system, including the cost of energy and maintenance..},
note={E14. The study uses the TRNSYS simulation environment combined with the DST module to simulate a real underground heat storage field. The study also employs a dynamic programming approach to develop the controller. The study considers several scenarios, including mild winter and summer, normal winter and summer, and cold winter and hot summer..},
note={E15. Results.},
note={E16. The algorithm allows for efficient heating and cooling of buildings, reducing the operation costs and avoiding exhausting the system. The system remained robust under all weather scenarios examined..},
note={E17. The study finds that the dynamic programming approach can effectively optimize the control of the ground heat storage system. The study presents the results of the dynamic programming approach, including the optimal control policy and the cost function. The study also presents the evolution of the cost function over time..},
note={E18. Conclusions.},
note={E19. The optimal control algorithm for borehole thermal energy storage systems can efficiently manage the operation costs and avoid exhausting the system, allowing for efficient heating and cooling of buildings. The algorithm can be used to reduce the investment cost of the system while guaranteeing the supply of needed heat and cold..},
note={E20. The study concludes that the dynamic programming approach can help to minimize costs and ensure a reliable heat and cold supply. The study also concludes that the optimal control policy depends on the temperature of the field, the demand for heat or cold, and the time of year. The study recommends the use of the dynamic programming approach for optimizing the control of ground heat storage systems.},
doi={10.1016/j.enbuild.2011.07.015},
url={https://doi.org/10.1016/j.enbuild.2011.07.015}
}

@Article{beaudry2022flow,
author={Beaudry, Gabrielle
and Pasquier, Philippe
and Marcotte, Denis
and Zarrella, Angelo},
title={Flow rate control in standing column wells: A flexible solution for reducing the energy use and peak power demand of the built environment},
journal={Applied Energy},
year={2022},
volume={313},
keywords={Standing column well; Simulation; ground heat exchanger; Ground-source heat pump; Power demand},
abstract={Standing column wells offer a generous and flexible solution to improve the energy efficiency of the built environment. As these systems behavior is strongly affected by groundwater advection, the acute challenge of predicting their thermal evolution with both accuracy and computational efficiency has so far hindered the development of design tools and optimized control strategies. In this work, a powerful simulation algorithm is implemented and applied to the performance assessment of multi-borehole standing column well systems located in a heterogeneous geological environment and operating under various constant and dynamic flow rate control strategies. The iterative algorithm relies on the non-stationary convolution technique to simulate the underground components, and the EnergyPlus approach to represent the heat pump efficiency at full and part loads. The findings suggest that using higher flow rates in peak conditions is a key element that minimizes auxiliary assistance and power demand. Complementary variable flow rate control aiming to maintain a 2 ◦C temperature difference across the plate heat exchanger has shown to alleviate groundwater usage and generate at least 8{\%}--11{\%} annual energy savings compared with constant flow. This operating strategy allowed the systems to deliver 197--246 W/m with a heating seasonal performance factor of 3.59. These results were achieved through 34 annual simulations having hourly time steps that were performed with the proposed algorithm in a total of 4 h 17 min, compared to 11 days for a single simulation using a numerical reference model.},
note={B. Participants: 4 performance indicators.},
note={B1. A detailed analysis of Case 4b with 5-SCWs is presented. This case is selected as it provides close to the best results obtained on all four performance indicators, namely the annual energy consumption (71 MWh), maximum power demand (35 kW), operating costs (9,799{\$}). and groundwater usage (23 ML).},
note={C. Highlights.},
note={C1. A powerful simulation algorithm is implemented and applied to the performance assessment of multi-borehole standing column well systems located in a heterogeneous geological environment and operating under various constant and dynamic flow rate control strategies.},
note={C2. The results of several annual simulations comparing various flow rate control strategies are presented to illustrate the beneficial effect of variable flow rate control for simultaneously reducing the systems' energy consumption, power demand, operating costs and groundwater usage.},
note={C3. The results demonstrate that variable flow rate control aiming to maintain a 2 {\textdegree}C fluid temperature difference across the heat pump leads to an increased energy efficiency, nearzero auxiliary solicitation and 35 kW of peak power usage instead of the 131 kW that would require an electric resistance heating system having a 100{\%} efficiency.},
note={C4. We proposed a powerful simulation algorithm allowing the fast computation of the operating temperatures and performance indicators of a standing column well (SCW) system.},
note={C5. We showed that this flexible modeling strategy allows considering important contributors to SCWs thermal efficiency, namely the presence of a multi-layered geological environment having heterogeneous hydraulic and thermal conductivity distributions, and the use of a variable flow rate control strategy.},
note={C6. ground-source heat pump (GSHP) have maintained an annual growth rate of around 10{\%} over the last ten years and reached a 77.5 GWt worldwide installed capacity as of 2020 [3].},
note={C7. These results reveal the potential of the proposed simulation algorithm for future design purposes and developing innovative control strategies, leading to improved performance of SCW systems.},
note={D. Findings.},
note={D1. GSHPs have maintained an annual growth rate of around 10{\%} over the last ten years and reached a 77.5 GWt worldwide installed capacity as of 2020 [3].},
note={D2. Montagud et al [9] estimated that this strategy can lead up to 28{\%} reductions in annual energy consumption.},
note={D3. Beurcq [13, 14] obtained similar results in a rare numerical study investigating the influence of control strategies on the operation of SCWs in cold climates. They demonstrated the interest of using a variable-speed submersible pump to control the pumping and discharge rates linearly as a function of the load on the building loop, with energy and costs savings going up to 20{\%} compared to good practice scenarios.},
note={D4. In Case 3, the discharge ratio is increased at 30{\%} for the highest flow rate level, in order to maximize the system's efficiency during peak demand periods.},
note={D5. The process is repeated iteratively until the correction on the ground loads is less than 0.75{\%} of the maximal load.},
note={D6. Note that the discharge flow rates increase from g1 to g8. The difference between both systems appears important at lower discharge ratios (g1 and g2 have ratios of 0{\%} and 10{\%}, respectively), while it gradually diminishes as this parameter increases (20{\%} for g3 to g7, and 30{\%} for g8).},
note={D7. The dynamic flow rate cases show more steady and resilient results, and use up to 11{\%} (4-SCWs) and 8{\%} (5-SCWs) less energy annually than the best constant flow rate scenarios.},
note={D8. Comparison of Case 3b with 4 SCWs and Case 4b with 5 SCWs, which are very similar in terms of annual energy use, peak demand and operating costs, also suggests that the better efficiency of the 5-SCWs system at lower discharge flow rates would allow reducing the annual volume of discharged groundwater by 32{\%} compared with the 4-SCWs.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study presents a simulation-based analysis of the energy performance of a water-to-water heat pump system using standing column wells (SCWs) for a school building, evaluating the impact of variable flow rate control on energy consumption, power demand, operating costs, and groundwater usage..},
note={E3. Key findings.},
note={E4. The key findings of the study suggest that using higher flow rates in peak conditions minimizes auxiliary assistance and power demand,. Additionally, complementary variable flow rate control aiming to maintain a 2 ◦C temperature difference across the plate heat exchanger can alleviate groundwater usage and generate at least 8{\%}--11{\%} annual energy savings,..},
note={E5. The study identifies three main geological units on the study site, including unconsolidated deposits, sandy dolomite, and quartz arenite, with a constant undisturbed ground temperature of 8.5 {\textdegree}C observed down to a 133 m depth. The water table static level is found to be at a 2.5 m depth, and a 0.006 m/m hydraulic gradient is observed on the site..},
note={E6. The study finds that variable flow rate control can reduce the system's energy consumption, power demand, operating costs, and groundwater usage, with the most efficient scenarios using dynamic flow rate control showing up to 11{\%} less energy consumption annually than the best constant flow rate scenarios..},
note={E7. The key findings of the study include the achievement of annual energy consumption of 71-76 MWh, operating costs of {\$}9,751-{\$}10,143, and a reduction in groundwater usage by 32{\%} when using a 5-SCW system compared to a 4-SCW system..},
note={E8. These results reveal the potential of the proposed simulation algorithm for future design purposes and developing innovative control strategies, leading to improved performance of SCW systems.},
note={E9. Objectives.},
note={E10. The objective of the study is to investigate the performance of a SCW system for heating and cooling, with a focus on minimizing energy use and cost. The study aims to evaluate the thermal behavior and performance of the SCW system, considering various control strategies involving constant and variable flow rates..},
note={E11. Methods.},
note={E12. The study uses an efficient iterative algorithm that relies on the non-stationary convolution technique to simulate the underground components and the EnergyPlus approach to represent the effect of temperature and fluid flow rate on the heat pump's efficiency,. Thirty-four annual simulations having hourly time steps are conducted to assess the performance of a SCW system operating under various constant and dynamic flow rate control strategies,..},
note={E13. The study uses a simulation algorithm to evaluate the thermal behavior and performance of the SCW system, with a modeling strategy that involves using a response model to evaluate the transfer functions that represent the normalized thermal behavior of the borehole fields. The study also uses finite element models to evaluate the transfer functions, coupling heat transfer to Darcian groundwater flow, and considering the hydraulic and thermal interactions between the boreholes..},
note={E14. The study uses a simulation-based approach, with the system modeled using the EnergyPlus approach, and the energy performance evaluated using a set of equations that take into account the thermal loads of the building, the ground loads, the work of the compressor, fluid pumps, and auxiliary equipment, as well as the pumping and circulation flow rates and the entering and leaving fluid temperature at the heat pump on the source side..},
note={E15. The study used a simulation algorithm that relies on the non-stationary convolution technique to simulate the system's underground components, and the EnergyPlus approach to represent the temperature and flow rate dependency of the heat pump's efficiency..},
note={E16. Results.},
note={E17. The results of the study show that the proposed algorithm can achieve fast simulation of SCWs operating under dynamic flow rate control,. The results also demonstrate the potential of flow rate control to improve the performance of SCWs, with energy savings of at least 8{\%}--11{\%} compared to constant flow,..},
note={E18. The study results show that the SCW system can be designed to cover 80{\%} of the peak power demand for heating, with an auxiliary electric resistance heating system to balance out the remaining loads. The study also investigates the effect of different control strategies on the system's performance, including constant and variable flow rates, and discharge flow rates..},
note={E19. The study presents a comprehensive overview of the system's annual energy consumption, peak power demand, operating costs, and groundwater usage, with the results showing that variable flow rate control can reduce the system's energy consumption, power demand, operating costs, and groundwater usage..},
note={E20. The results of the study showed that the SCW system achieved annual energy consumption of 71-76 MWh, operating costs of {\$}9,751-{\$}10,143, and a reduction in groundwater usage by 32{\%} when using a 5-SCW system..},
note={E21. Conclusions.},
note={E22. The study concludes that the proposed algorithm is a powerful tool for simulating SCWs and evaluating the impact of flow rate control strategies on their performance,. The study also highlights the potential of SCWs as a flexible solution for reducing energy use and peak power demand in the built environment,..},
note={E23. The study concludes that the SCW system can be an effective solution for heating and cooling, with a focus on minimizing energy use and cost. The study highlights the importance of considering the geological units and groundwater flow regime in the design and operation of the SCW system..},
note={E24. The study concludes that variable flow rate control is a cost-effective solution that allows minimizing both the energy consumption and power usage of the system, with the most efficient scenarios using dynamic flow rate control showing up to 11{\%} less energy consumption annually than the best constant flow rate scenarios..},
note={E25. The study concluded that SCW systems are flexible and can achieve high thermal efficiency due to their ability to work with conductive and advective heat transfer, and that an adapted variable flow rate control strategy can take advantage of these features to ensure the system's performance.},
doi={10.1016/j.apenergy.2022.118774},
url={https://doi.org/10.1016/j.apenergy.2022.118774}
}

@Article{mader2014capacity,
author={Mader, Gunda
and Madani, Hatef},
title={Capacity control in air--water heat pumps: Total cost of ownership analysis},
journal={Energy and Buildings},
year={2014},
volume={81},
keywords={Heat pump; climate zone; total cost of ownership; Optimization},
abstract={Adjusting capacity to changing demand by variable speed control is known to offer efficiency improvement over classical on/off control. With a total cost of ownership analysis the economic viability of both control schemes is assessed for residential air--water heat pumps operating in different climate zones. Component sizes are optimized for both control methods individually. Results show optimal compressor displacement volumes to be smaller for variable speed than for on/off control. The optimal ratio of evaporator to condenser size is smaller for the variable speed system. Variable speed control is shown to be uneconomic for space heating in warmer climate while for average climate cost-effectiveness depends on the economic framework. For colder climate variable speed control is the more profitable choice in all considered cases; savings of up to 5000 EUR compared to on/off control can be achieved within 15 years of operation.},
note={C. Highlights.},
note={C1. Changes in the control scheme can reduce emissions associated with air source heat pumps operating over a wide range of conditions by more than a third [1].},
note={C2. The gradient of the curves steepen, when electric heat is added. This occurs for the fixed speed on/off (FS) system below balance point temperature Ta,b and for variable speed (VS) control below the upper speed limit temperature Ta,u.},
note={C3. The general trend for differences in total cost of ownership (TCO) is not reversed: In the warm climate zone VS control is too costly, in the average climate zone the benefit depends on the economic framework and variable speed control pays off in the colder climate.},
note={C4. It can be assumed that effects of points above and below the linear curve will outbalance each other in an economic comparison of fixed and variable speed control.},
note={C5. Variable speed units optimized for colder climates are slightly more cost efficient when run in the average climate than fixed speed units optimized for colder climates.},
note={C6. In the warmer climate zone the most cost efficient option is a fixed speed unit optimized for the conditions encountered there.},
note={D. Findings.},
note={D1. The performance of the FS unit with electrical backup heat covering less than 5{\%} of the annual demand was the same as the performance of the VS unit.},
note={D2. Deviations between seasonal power consumption calculated by Eq (3) and by the quadratic model (Eq (4)) are below 0.5{\%} within the design region.},
note={D3. At higher ambient temperatures isentropic efficiency is up to 8{\%} higher for FS operation.},
note={D4. Within the given size limits a maximum TCO increase of about 12{\%} can be observed for undersized heat exchangers.},
note={D5. {\textbullet} No up to date values for prices of speed control of compressor and fan were available. 50{\%} higher costs than assumed in this study increase payback time to 4 years for colder and 11 years for average climate (0.21 EUR kWh−1, interest rate 3{\%}).},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study compares the economic performance of fixed speed (FS) and variable speed (VS) control in air-water heat pumps, finding that VS control is most promising for colder climate zones, with a decrease in total cost of ownership (TCO) difference of about 20{\%} when the cycle degradation coefficient is increased from 0.9 to 0.95..},
note={E3. Key findings.},
note={E4. The study finds that variable speed control can be more profitable in colder climates, with savings of up to 5000 EUR compared to on/off control within 15 years of operation, and that optimal compressor displacement volumes are smaller for variable speed than for on/off control..},
note={E5. The key findings of the study are that VS control reduces operating costs of the heat pump below the balance point temperature of the FS system, but above this temperature, the operating costs for the VS system become higher than for on/off control. The study also finds that the optimal component selection, such as compressor size and heat exchanger size, varies depending on the climate zone and control mode..},
note={E6. The study finds that VS control lowers operating costs mainly by reducing electricity consumption at low ambient temperatures. The optimal component sizes differ for FS and VS control, with the optimized VS unit still requiring electric backup heating. The study also finds that the benefit of VS control is higher in colder climate zones, where the unit operates constantly, resulting in slower frost growth..},
note={E7. Variable speed units optimized for colder climates are slightly more cost efficient when run in the average climate than fixed speed units optimized for colder climates.},
note={E8. In the warmer climate zone the most cost efficient option is a fixed speed unit optimized for the conditions encountered there.},
note={E9. Objectives.},
note={E10. The objective of the study is to quantify the total cost of ownership (TCO) of VS and FS control in residential air-water heat pumps for different climate zones, including investment costs and operating costs throughout the economic lifetime..},
note={E11. Methods.},
note={E12. The study uses a simulation model of a typical heat pump cycle, comprising submodels of the compressor, evaporator, condenser, and expansion device, and optimizes component sizes to give minimum TCO for both FS and VS systems..},
note={E13. The study uses a quadratic model to describe the seasonal power consumption of the system as a function of the inner heat transfer area of the evaporator and condenser. The study also uses the Design of Experiment (DoE) theory to minimize the number of simulation runs required for regression of the quadratic models..},
note={E14. The study uses simulations to compare the performance of FS and VS control, considering various system parameters and climate zones. The study also uses cycle equations and NTU correlations to model the heat transfer capacity of the evaporator and condenser. The study employs compressor polynomials to express nominal evaporator capacity and nominal compressor power consumption as a function of evaporation and condensation pressure..},
note={E15. Results.},
note={E16. The study finds that variable speed control can reduce emissions associated with air source heat pumps operating over a wide range of conditions by more than a third, and that the optimal ratio of evaporator to condenser size is smaller for the variable speed system..},
note={E17. The results of the study show that the TCO of the VS system is lower than that of the FS system in the colder climate zone, but higher in the warmer climate zone. The study also finds that the optimal heat exchanger size and compressor size vary depending on the climate zone and control mode..},
note={E18. The study finds that VS control is most promising for colder climate zones, with a decrease in TCO difference of about 20{\%} when the cycle degradation coefficient is increased from 0.9 to 0.95. The study also finds that the optimal component sizes differ for FS and VS control, with the optimized VS unit still requiring electric backup heating. The results show that the benefit of VS control is higher in colder climate zones, where the unit operates constantly, resulting in slower frost growth..},
note={E19. Conclusions.},
note={E20. The study concludes that variable speed control can be a more profitable option for residential air-water heat pumps in colder climates, and that optimizing component sizes is crucial to minimize total cost of ownership..},
note={E21. The conclusions of the study are that the VS system is cost-efficient in the colder climate zone, but not in the warmer climate zone. The study also concludes that the optimal component selection, such as compressor size and heat exchanger size, varies depending on the climate zone and control mode..},
note={E22. The study concludes that VS control is most promising for colder climate zones, with a decrease in TCO difference of about 20{\%} when the cycle degradation coefficient is increased from 0.9 to 0.95. The study also concludes that the optimal component sizes differ for FS and VS control, with the optimized VS unit still requiring electric backup heating. The study suggests that further research is required to quantify the effect of tap water heating on the benefit of VS control.},
doi={10.1016/j.enbuild.2014.06.029},
url={https://doi.org/10.1016/j.enbuild.2014.06.029}
}

@Article{montagud2013situ,
author={Montagud, Carla
and Corber{\'a}n, Jos{\'e} M.
and Montero, {\'A}lvaro},
title={In situ optimization methodology for the water circulation pumps frequency of ground source heat pump systems},
journal={Energy and Buildings},
year={2013},
volume={68},
keywords={Ground source heat pump; energy performance; Energy efficiency; val{\`e}ncia; IDAE},
abstract={This paper presents an experimental study of the influence of the water circulation pumps frequency at the indoor and outdoor loops in the overall system performance of a ground source heat pump monitored plant, and describes a three steps new methodology to optimize the system energy performance and obtain the values of the optimal frequencies when ON/OFF regulation is employed. The first step consists of several experimental tests of pseudo-random sequence of frequency steps for both, internal and external circulation pumps, carried out during a single day. The second step is the characterization of the quasi-steady state system performance as a function of circulation pumps frequencies. The final step consists of, by means of an analytical expression, the extrapolation of results to any partial load ratio, what allows finding the optimal frequency as a function of the instantaneous thermal load. The advantage of the proposed methodology is that it can be carried out on site and is able to consider the phenomena occurring at the heat pump and the ground source heat exchanger when the flow rates are varied. The methodology can be applied to any installation incorporating variable speed circulation pumps. Results indicate large energy savings potential for this kind of installation.},
note={C. Highlights.},
note={C1. According to data provided by IDAE [4], energy consumption in buildings in Spain accounts for 20{\%} of final energy consumption, a figure that tends to increase.},
note={C2. The purpose of this paper is to examine the influence of the flow rate of the water circulation pumps on the overall performance of a ground source heat pump system for heating and cooling, as well as the optimization of their frequency in order to lead to the minimal energy consumption of the entire system.},
note={C3. Energy efficiency parameters are calculated from the power consumption readings and the heat transferred from the heat pump to the internal circuit, which is estimated from the values of TINIC, TOUTIC and the water flow rate m.},
note={C4. The first step consists in the experimental characterization of the system energy performance (COPSYSTEM) as a function of the circulation pump frequencies during one entire day for heating and one for cooling.},
note={C5. Further optimization is to be carried out in Geocool installation where appropriate control algorithms, including adequate control strategies to ensure users comfort will be implemented in order to optimize the daily energy performance of the system.},
note={D. Findings.},
note={D1. The results show that there is a high potential for energy savings which has been estimated as 28{\%} of annual electricity consumption for the studied case.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study proposes a methodology for optimizing the frequency of water circulation pumps in a geothermal system with ON/OFF regulation, which consists of three steps: characterization of system performance, estimation of system COP maps, and estimation of system performance maps for any thermal load..},
note={E3. Key findings.},
note={E4. The study found that optimizing the water circulation pumps frequency can lead to large energy savings, and that the higher the flow rate at both the external and internal circuit, the better the COP of the heat pump..},
note={E5. The study reveals that the influence of water flow rates on the heat pump system is not linear, and there exists an optimum frequency for each water loop, with increasing water flow rates diminishing compressor consumption but increasing circulation pumps consumption..},
note={E6. The study found that the optimal frequencies for the circulation pumps depend on the operating conditions, and that the system's performance can be improved by optimizing the pump frequencies. The study also found that the internal circulation pump consumption contributes to the heating, adding useful heat, while in cooling mode, it has the opposite effect..},
note={E7. The study found that the optimal circulation pump frequencies vary depending on the load ratio, with lower frequencies resulting in lower optimal frequencies at lower loads. The optimal frequencies for heating and cooling modes were found to be different, with 40 Hz for the internal pump and 30 Hz for the external one in heating mode, and 30 Hz for the internal pump and 40 Hz for the external one in cooling mode..},
note={E8. Further optimization is to be carried out in Geocool installation where appropriate control algorithms, including adequate control strategies to ensure users comfort will be implemented in order to optimize the daily energy performance of the system.},
note={E9. Objectives.},
note={E10. The purpose of the paper is to examine the influence of the flow rate of the water circulation pumps on the overall performance of a ground source heat pump system for heating and cooling, as well as the optimization of their frequency in order to lead to the minimal energy consumption of the entire system..},
note={E11. Methods.},
note={E12. The study employed a three-step methodology: (1) several experimental tests of pseudo-random sequence of frequency steps for both internal and external circulation pumps, (2) characterization of the quasi-steady state system performance as a function of circulation pumps frequencies, and (3) extrapolation of results to any partial load ratio using an analytical expression..},
note={E13. The study uses experimental and monitoring methods to analyze the performance of the heat pump system, including measuring water temperatures, flow rates, and power consumption of each system component..},
note={E14. The study uses a quasi-steady state mathematical model of the installation, which was validated by comparison with experimental data. The study also employs an analytical methodology to estimate the system performance factor as a function of the partial load ratio..},
note={E15. The methodology consists of three steps: experimental characterization of the system energy performance, quasi-steady state performance maps construction, and extrapolating the quasi-steady COPSYSTEM values to any load ratio. The study used experimental measurements and analytical expressions to develop the methodology..},
note={E16. Results.},
note={E17. The results show that the higher the inverter frequency, the greater the circulating water flow rate, and that the power consumption typically increases in a cubic manner with flow rate..},
note={E18. The results show that the compressor power consumption is the greatest, accounting for 83{\%} of the total consumption, while the internal circulation pump consumption is relatively high, around 12{\%} of the compressor power..},
note={E19. The study found that the optimal frequencies for the circulation pumps depend on the operating conditions, and that the system's performance can be improved by optimizing the pump frequencies. The study also found that the internal circulation pump consumption contributes to the heating, adding useful heat, while in cooling mode, it has the opposite effect..},
note={E20. The results show that the optimal frequencies for heating and cooling modes vary depending on the load ratio, with lower frequencies resulting in lower optimal frequencies at lower loads. The study estimated a potential annual energy savings of 28{\%}..},
note={E21. Conclusions.},
note={E22. The study concludes that optimizing the water circulation pumps frequency can lead to large energy savings, and that the proposed methodology can be applied to any installation incorporating variable speed circulation pumps..},
note={E23. The study concludes that there is an optimum frequency for each water loop, and the energy efficiency parameters can be calculated from monitored data, allowing for the evaluation of the system's performance..},
note={E24. The study concludes that the proposed methodology is effective in optimizing the frequency of water circulation pumps in a geothermal system with ON/OFF regulation. The study also concludes that the system's performance can be improved by optimizing the pump frequencies, taking into account the operating conditions and the system's characteristics.},
doi={10.1016/j.enbuild.2013.09.030},
url={https://doi.org/10.1016/j.enbuild.2013.09.030}
}

@Article{cervera2014situ,
author={Cervera-V{\'a}zquez, J.
and Montagud, Carla
and Corber{\'a}n, Jos{\'e} M.},
title={In situ optimization methodology for the water circulation pumps frequency of ground source heat pump systems: Analysis for multistage heat pump units},
journal={Energy and Buildings},
year={2014},
volume={88},
keywords={Ground source heat pump; energy performance; water circulation; Auxiliaries},
abstract={In order to optimize the global energy performance of a ground source heat pump system, special attention needs to be paid to the auxiliaries as they stand for a considerable part of the total energy consumption. A new in situ experimental methodology based on the frequency variation of the water circulation pumps in order to optimize the energy performance of the system was previously published by the authors for a ground source heat pump system using a single stage heat pump with ON/OFF regulation. The original single stage heat pump was recently replaced with a multistage unit consisting of two compressors of the same capacity working in tandem. A new experimental campaign was carried out and a new study was performed in order to adapt the in situ optimization methodology to the performance of the tandem compressors unit, and, by extension, to the multistage case. This paper presents the in situ optimization methodology for the water circulation pumps frequency adapted for multistage ground source heat pump systems. Results show that energy savings up to 32{\%} can be obtained by applying this optimization methodology.},
note={B. Participants: 1 data.},
note={B1. Given that the analyzed heat pump consists of two compressors in tandem, the performance will be different whether there is one or there are two compressors running, i.e. only one compressor cycling ON/OFF or one compressor continuously running and the other one cycling ON/OFF. Therefore, step 1 tests must be carried out for both operation states (n = 1 and n = 2). For this particular installation, it has been experimentally confirmed that the optimum frequencies are located at higher values when both compressors are running (around 45--50 Hz), and hence there is no need for testing frequencies lower than 35 Hz.},
note={C. Highlights.},
note={C1. In the current context of global warming concern, special attention should be paid to the efficient use of renewable energies.},
note={C2. The authors previously developed an experimental in situ optimization methodology for the water circulation pumps frequency of ground source heat pump systems when single stage ON/OFF regulation is employed [12].},
note={C3. This paper describes the in situ methodology to determine those optimum frequencies for a multistage heat pump unit.},
note={C4. When analyzing a multistage heat pump unit, which consists of a specific number of compressors (N) working in tandem, special attention should be paid to the thermal demand of the building, since it will determine the number of stages in operation and the compressor consumption.},
note={C5. The methodology previously developed and published by the authors for single stage heat pump units with ON/OFF regulation was adapted for multistage heat pump units.},
note={C6. Given that the in situ optimization methodology has been developed for both single stage and multistage heat pump units with ON/OFF regulation, further studies will focus on the adaptation of the methodology to Ground source heat pump (GSHP) installations with variable speed heat pump units.},
note={D. Findings.},
note={D1. Results show that energy savings up to 32{\%} can be obtained by applying this optimization methodology.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study presents an in situ experimental methodology to optimize the circulation pumps frequency of a geothermal heat pump installation, leading to minimum energy consumption, by characterizing the performance of the system during the ON time of the compressor at any possible combination of frequencies..},
note={E3. Key findings.},
note={E4. The key findings of the study include the development of an in situ optimization methodology for the water circulation pumps frequency of ground source heat pump systems with multistage heat pump units, and the determination of the optimal pair of frequencies for the water loops to achieve energy savings..},
note={E5. The study found that the optimal frequencies are located at higher values when both compressors are running, and the performance maps of the unit can be obtained as a function of both the external and internal circulation pumps frequency..},
note={E6. The study found that the optimization methodology resulted in energy savings of 29{\%} for a single day and 31.70{\%} for the entire heating season. The optimal frequencies for the circulation pumps were found to be higher for higher partial load ratios..},
note={E7. The key findings of the study were that the optimized control system resulted in energy savings of 29.4{\%} for a typical heating day and 31.70{\%} over the entire analyzed period..},
note={E8. Given that the in situ optimization methodology has been developed for both single stage and multistage heat pump units with ON/OFF regulation, further studies will focus on the adaptation of the methodology to Ground source heat pump (GSHP) installations with variable speed heat pump units.},
note={E9. Objectives.},
note={E10. The objective of the study is to optimize the energy performance of ground source heat pump systems with multistage heat pump units by developing an in situ optimization methodology for the water circulation pumps frequency..},
note={E11. Methods.},
note={E12. The study uses an experimental approach, with a network of sensors set up to monitor the installation, including water temperatures, mass flow rates, and power consumptions..},
note={E13. The methodology consists of three steps: (1) experimental tests of pseudorandom sequence of frequency steps for both internal and external circulation pumps, (2) analysis of the results and estimation of the system COP, and (3) extrapolation of the performance maps to any partial load ratio of the system..},
note={E14. The methodology involved experimental tests to determine the optimal frequencies for the circulation pumps, which were then implemented in the control board of the heat pump unit. The tests were carried out for different partial load ratios and working modes (heating and cooling)..},
note={E15. The methods used in the study involved continuously monitoring the heat pump system over several months and comparing the optimized control to a standard control..},
note={E16. Results.},
note={E17. The results of the study show that energy savings of up to 32{\%} can be achieved by applying the optimization methodology, and that the optimal pair of frequencies for the water loops depends on the thermal demand of the building..},
note={E18. The study obtained the system COP maps for one typical heating and one typical cooling day, and the optimal pair of frequencies corresponds to quasisteady state working conditions..},
note={E19. The results showed that the optimization methodology resulted in energy savings and improved system performance. The optimal frequencies for the circulation pumps were found to be higher for higher partial load ratios..},
note={E20. The results of the study showed that the optimized control system resulted in significant energy savings, with a 29.4{\%} savings for a typical heating day and a 31.70{\%} savings over the entire period..},
note={E21. Conclusions.},
note={E22. The study concludes that the in situ optimization methodology for the water circulation pumps frequency of ground source heat pump systems with multistage heat pump units is effective in achieving energy savings, and that the optimal pair of frequencies for the water loops depends on the thermal demand of the building..},
note={E23. The study concludes that the proposed methodology can be applied to any installation provided with a multistage heat pump unit with more than two compressors, and the system performance factor can be obtained as a function of the partial load ratio of each stage..},
note={E24. The study concluded that the optimization methodology is effective in improving the energy efficiency of ground source heat pump systems with multistage heat pump units. The methodology can be used to optimize the performance of such systems and reduce energy consumption..},
note={E25. The conclusions of the study were that the optimized control system is effective in reducing energy consumption for heat pump systems.},
doi={10.1016/j.enbuild.2014.12.008},
url={https://doi.org/10.1016/j.enbuild.2014.12.008}
}

@Article{benassi2015energy,
author={Del Col, Davide
and Azzolin, Marco
and Benassi, G.
and Mantovan, Mauro},
title={Energy efficiency in a ground source heat pump with variable speed drives},
journal={Energy and Buildings},
year={2015},
volume={91},
keywords={Model; Control; COP3; Ground source heat pump; water pump; borehole heat exchanger; brushless DC},
abstract={A variable capacity heat pump, with variable speed drives on the secondary circuits, needs an adequate control for achieving the maximum energy efficiency. In the present paper, experimental data and a modeling procedure of a ground source heat pump (GSHP) with variable speed compressor, variable speed water pumps and variable speed fans in the coils are reported. Both data and model are used to evaluate the operating conditions that lead to the maximum seasonal coefficient of performance of the system. The control parameters that can be varied are the followings: frequency of compressor, frequency of water pump to the borehole heat exchangers, frequency of the water pump to the user, velocity of the fans, water temperature to the user. From the experimental data, it was possible to define a control variable which is the ratio of compressor electric power consumption to the power absorbed by the water pumps. The model is also the baseline to develop a control strategy that is implemented in the present GSHP system, developed in the framework of the European Project Ground-Med, with the final objective of maximizing the seasonal coefficient of performance of the system.},
note={C. Highlights.},
note={C1. It was possible to define a control variable which is the ratio of compressor electric power consumption to the power absorbed by the water pumps.},
note={C2. The parameters that can be varied for the heat pump system control are: electric frequency of compressor, frequency of water pump in the external circuit, frequency of the water pump in the internal circuit, velocity of the fans and supply water temperature to the fan coils.},
note={C3. Experimental COP curves at constant load ratio are plotted as a function of the water temperature difference in the borehole heat exchangers and in the building loop.},
note={C4. (2) At higher load ratio the maximum COP3 is obtained for a water temperature difference at the condenser of about 5 K and at the evaporator of 2.8 K.},
note={C5. When decreasing the load ratio, the maximum COP3 value is obtained at the minimum values of water flow rate to the borehole heat exchangers and to the building because at partial loads the heat exchangers are somehow oversized.},
note={C6. Comparing the calculated SCOP3, at the same operating conditions, an increase of about 30{\%} could be achieved using a brushless DC (BLDC) motor compressor instead of the inverter-driven asynchronous motor compressor.},
note={C7. The main components of the system are modeled with ad-hoc lookup tables (LUTs) which have been calibrated using the experimental data taken from the heat pump installed at the demo site.},
note={D. Findings.},
note={D1. Considering the seasonal coefficient of performance, this study indicates that if the on/off controlled systems are designed to cover more than 65{\%} of the building peak demand, there is no considerable difference with the variable capacity system.},
note={D2. If the on/off controlled heat pump is oversized, covering more than 94{\%} of the building peak heat demand, the annual energy consumption is the lowest but economic constraints prevent the system to be the best option; if the on/off controlled heat pump is dimensioned to cover only the 55{\%} of the peak demand, it gives the highest annual energy consumption due to the large use of electrical auxiliary heaters.},
note={D3. The authors pointed out that in the variable speed heat pumps the energy consumptions of the water pumps were 5--30{\%} higher than the on/off controlled heat pumps, due to longer working time of pumps over a year.},
note={D4. Comparing the calculated SCOP3, at the same operating conditions, an increase of about 30{\%} could be achieved using a BLDC motor compressor instead of the inverter-driven asynchronous motor compressor.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study analyzes the performance of a ground source heat pump system, focusing on the optimization of its coefficient of performance (COP) by controlling various parameters such as water flow rates and supply water temperature..},
note={E3. Key findings.},
note={E4. The key findings of the study include the importance of control parameters such as frequency of compressor, frequency of water pump, and velocity of fans in achieving maximum energy efficiency. The study also highlights the need for a satisfactory regulation to achieve the maximum coefficient of performance when varying the load..},
note={E5. (2) At higher load ratio the maximum COP3 is obtained for a water temperature difference at the condenser of about 5 K and at the evaporator of 2.8 K.},
note={E6. When decreasing the load ratio, the maximum COP3 value is obtained at the minimum values of water flow rate to the borehole heat exchangers and to the building because at partial loads the heat exchangers are somehow oversized.},
note={E7. Comparing the calculated SCOP3, at the same operating conditions, an increase of about 30{\%} could be achieved using a brushless DC (BLDC) motor compressor instead of the inverter-driven asynchronous motor compressor.},
note={E8. The main components of the system are modeled with ad-hoc lookup tables (LUTs) which have been calibrated using the experimental data taken from the heat pump installed at the demo site.},
note={E9. Objectives.},
note={E10. The objectives of the study include evaluating the experimental in-situ performance of a ground source heat pump system, developing a numerical model to predict the system behavior, and investigating the potential to improve the system's seasonal efficiency. The study aims to maximize the seasonal system performance by developing a control strategy with double regulation and proportional integral action..},
note={E11. Methods.},
note={E12. The study uses a combination of experimental data and modeling to investigate the energy efficiency of the GSHP system. The experimental data are compared with a model of the GSHP system with variable speed drives..},
note={E13. The methods used in the study include experimental measurements and numerical modeling. The numerical model is composed of lookup tables (LUTs) that represent the behavior of the evaporator, condenser, compressor, and fan coils..},
note={E14. Results.},
note={E15. The results of the study show that the energy efficiency of the GSHP system can be improved by adjusting the control parameters such as frequency of compressor and velocity of fans. The study also finds that the power consumption of the water pumps at partial loads is an important factor in determining the overall energy efficiency of the system..},
note={E16. Conclusions.},
note={E17. The study concludes that a satisfactory regulation is necessary to achieve the maximum coefficient of performance when varying the load. The study also highlights the importance of considering the behavior of the system at partial loads to increase the energy efficiency..},
note={E18. The conclusions of the study include the importance of optimizing the COP of the ground source heat pump system by controlling various parameters. The study also highlights the opportunity of using the ratio of compressor electric power consumption to the electric power absorbed by the water pumps as a control variable in the regulation strategy..},
note={E19. The conclusions of the study highlight the importance of adjusting the water mass flow rate and the potential to improve the system's seasonal efficiency using a brushless DC motor compressor. The study demonstrates the effectiveness of the developed control strategy in maximizing the seasonal system performance.},
doi={10.1016/j.enbuild.2014.12.048},
url={https://doi.org/10.1016/j.enbuild.2014.12.048}
}

@Article{capozza2015long,
author={Capozza, Antonio
and Zarrella, Angelo
and De Carli, Michele},
title={Long-term analysis of two GSHP systems using validated numerical models and proposals to optimize the operating parameters},
journal={Energy and Buildings},
year={2015},
volume={93},
keywords={Borehole; Heat pump; ground source heat pump; coefficient of performance; borehole heat exchangers; ASHRAE; Ground heat exchanger},
abstract={An important consideration with regard to ground source heat pump (GSHP) systems is ensuring high energy efficiency performance throughout the years. Multi-year analyses are thus exceedingly important to evaluate the seasonal oscillations in the ground temperature and its long-term drift.As only a limited number of results based on real cases are available in the literature, this work aims to address this paucity of information. Seasonal and long-term computer simulations were conducted in order to investigate the thermal performance of two office buildings in Italy with unbalanced load profiles. The study focuses on the evaluation of ground temperature drift which was essentially due to an imbalance of the buildings' load profile.},
note={B. Participants: 90 people.},
note={B1. Three floors are above the ground and one is underground (see Fig. 2a). Approximately 90 people work in the building. The north and south facades are completely glazed.},
note={C. Highlights.},
note={C1. Over recent decades, ground source heat pump (GSHP) systems, which are used worldwide for space heating and cooling of buildings, have been shown to be an attractive as well as promising technology [1].},
note={C2. The main disadvantage of GSHP systems compared to conventional ones is higher initial costs which include those covering the geotechnical investigations and inspections on the ground and linked to the thermal-physical characteristics of groundwater as well as of drilling a borehole ground heat exchanger or wells to extract groundwater.},
note={C3. Using TRNSYS, Montagud et al [12] analyzed a complete GSHP system consisting of six vertical boreholes and compared the simulation results with experimental measurements for one operational day in the cooling mode of a reversible water-to-water heat pump of nominal heating and cooling capacities equal to 18 kW and 14 kW, respectively.},
note={C4. Great differences were instead found in carried out in the second building (Case B) with regard to the thermal performance of the GSHP system owing to the totally different design loads found during the monitoring activity.},
note={C5. From a strictly energetic viewpoint, an improvement in plant performance follows when the ratio between the heating and cooling loads to the heat pumps is rebalanced by hybrid GSHP systems, i.e. by auxiliary equipment improving the surplus cooling/heating loads: chillers in Case A, auxiliary heaters in Case B.},
note={C6. The energetic-economic evaluation did not justify adopting supplementary borehole heat exchangers (BHEs); load balancing could be appropriate if the auxiliary equipment was already installed in the plant and if its cost was negligible and lowered operating expenses.},
note={D. Findings.},
note={D1. At optimum conditions, the average coefficient of performance (COP) of the hybrid GSHP system increased by approximately 7.2{\%} compared with that of the pure one.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study evaluates the performance of a ground source heat pump (GSHP) system, analyzing the effects of thermal drift and heat imbalance on the system's efficiency and operating costs, and compares different strategies to improve the system's performance, including load balancing and increasing the number of boreholes..},
note={E3. Key findings.},
note={E4. The key findings of the study are that rebalancing the ratio between the heat extracted from and injected into the ground leads to better results from an energetic viewpoint, and that increasing the number of boreholes can reduce seasonal oscillations and thermal drift..},
note={E5. The study uses different approaches, including the CaRM simulation tool and the ASHRAE method, to analyze the long-term thermal performance of the two GSHP systems. The results show that the ground heat loads were used as data in the simulations carried out using the CaRM tool..},
note={E6. The key findings of the study include the significant impact of thermal drift on the long-term performance of GSHP systems, and the importance of considering ground heat load imbalance in system design, as well as the effectiveness of increasing the number of boreholes in reducing thermal drift..},
note={E7. The study finds that reducing the heat imbalance on the ground side is the key factor to limiting the effect of the thermal drift, and that increasing the number of boreholes does not significantly affect the thermal drift. The study also finds that the ground temperature drift depends primarily on the annual heat imbalance between heating and cooling loads. Additionally, the study shows that load balancing can lead to lower electricity consumption of heat pumps than increasing the number of boreholes..},
note={E8. The energetic-economic evaluation did not justify adopting supplementary borehole heat exchangers (BHEs); load balancing could be appropriate if the auxiliary equipment was already installed in the plant and if its cost was negligible and lowered operating expenses.},
note={E9. Objectives.},
note={E10. The objective of the study is to address the paucity of information on the long-term thermal behavior of ground source heat pump systems, and to evaluate the effects of improved load balancing and increased number of boreholes on the thermal performance of the systems..},
note={E11. Methods.},
note={E12. The study uses seasonal and long-term computer simulations to investigate the thermal performance of the ground source heat pump systems, and compares the results to two analytical approaches available in the literature..},
note={E13. The study uses a combination of numerical and analytical models to analyze the long-term thermal performance of the two GSHP systems. The CaRM simulation tool is used as the numerical approach, while the ASHRAE method and the infinite line source model are used as analytical approaches..},
note={E14. The study uses a combination of simulation tools, including CaRM, and analysis procedures, such as the ASHRAE method, to evaluate the long-term thermal performance of the GSHP systems, and to assess the effects of thermal drift and ground heat load imbalance..},
note={E15. Results.},
note={E16. The results of the study show that rebalancing the ratio between the heat extracted from and injected into the ground leads to better results from an energetic viewpoint, and that increasing the number of boreholes can reduce seasonal oscillations and thermal drift..},
note={E17. The study finds that the ground temperature drift depends primarily on the annual heat imbalance between heating and cooling loads. The study also finds that reducing the heat imbalance on the ground side is the key factor to limiting the effect of the thermal drift. The results of the study are summarized in Tables 4, 5, and 6..},
note={E18. Conclusions.},
note={E19. The conclusions of the study are that ground source heat pump systems can be an attractive and promising technology for space heating and cooling of buildings, but that careful design and optimization are necessary to ensure high energy efficiency performance..},
note={E20. The study concludes that the use of different approaches, including numerical and analytical models, can help improve the design and operation of GSHP systems..},
note={E21. The conclusions of the study highlight the importance of considering thermal drift and ground heat load imbalance in the design of GSHP systems, and the need for careful evaluation of system performance over the long term, using tools such as CaRM and ASHRAE procedures.},
doi={10.1016/j.enbuild.2015.02.005},
url={https://doi.org/10.1016/j.enbuild.2015.02.005}
}

@Article{mu2015extremum,
author={Hu, Bin
and Li, Yaoyu
and Mu, Baojie
and Wang, Shaojie
and Seem, John E.
and Cao, Feng},
title={Extremum seeking control for efficient operation of hybrid ground source heat pump system},
journal={Renewable Energy},
year={2015},
volume={86},
keywords={Ground Source Heat Pump; ground heat exchanger; Modelica; power consumption; dynamic simulation; artificial neural networks},
abstract={The Hybrid Ground Source Heat Pump (GSHP) systems combine the renewable geothermal energy and cooling tower for rejecting the cooling load, which is often adopted for high cooling demand. Model based control can be limited due to variations in ambient conditions, ground-loop heat exchanger (GHE) and equipment characteristics, cost and reliability of sensors. A self-optimizing control scheme is proposed for efficient operation of the hybrid GSHP based on Extremum Seeking Control (ESC), with feedback of the total power consumption and the control inputs of the relative flow rate of cooling tower and the water pump speed. The cooling capacity of the heat pump regulates the evaporator leaving water at 7 C. A Modelica based dynamic simulation model is developed for a Hybrid GSHP system, with the vertical GHE model adopted from Modelica Buildings Library. The transient heat transfer is implemented with a finite volume method inside and outside the borehole. The proposed ESC scheme is evaluated under the scenarios of fixed cooling load, ramp change in the evaporator inlet water temperature, diurnal sinusoidal cycle of air wet-bulb temperature, and realistic ambient and cooling load condition. Simulation results show the proposed ESC strategy effectively achieves nearly optimal efficiency without the need for plant model.},
note={C. Highlights.},
note={C1. The Ground Source Heat Pump (GSHP) is a technology that utilizes the renewable geothermal energy for space heating and air conditioning of residential and commercial buildings, which has demonstrated higher energy efficiency for residential and commercial buildings [1].},
note={C2. Entering the heat pump and performance degradation of the GSHP system [2]. This problem may be solved by increasing the total capacity of ground heat exchanger (GHE); the system capacity is limited by the initial cost of construction.},
note={C3. Li et al [30] used an Extremum Seeking Control (ESC) scheme for chilled-water system to look for the energy efficient operation and presented a Modelica based dynamic simulation model for demonstrating the effectiveness of the proposed control strategy.},
note={C4. This paper presents a multi-variable ESC based hybrid GSHP control scheme which can minimize the combined power consumption of GHE loop water pump, cooling tower fan and pump, and heat pump compressor.},
note={C5. The multi-variable ESC control strategy is tested on a dynamic simulation model of the hybrid GSHP system developed by utilizing the Modelica Buildings Library and TIL Library.},
note={C6. This study indicates significant potential for ESC to achieve good energy efficiency in real time with a model-free advantage.},
note={D. Findings.},
note={D1. The multi-variable ESC controller is simulated for the hybrid GSHP system under 100{\%} cooling load conditions.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study presents a dynamic simulation model of a hybrid ground source heat pump (GSHP) system, which is developed using Dymola 2014, Modelica Buildings Library 1.5, and TIL Library 3.1.0, and a two-input extremum seeking control (ESC) scheme is proposed to optimize the system's performance..},
note={E3. Key findings.},
note={E4. The proposed ESC scheme effectively achieves nearly optimal efficiency without the need for a plant model,. The study also finds that the ESC scheme requires minimal measurement, i.e., the total power measurement only, which can significantly reduce the cost of sensor acquisition, installation, and maintenance,..},
note={E5. The study proposes a two-input ESC scheme to optimize the hybrid GSHP system's performance, which aims to minimize the total power consumption of the system. The ESC scheme uses the cooling-tower fan relative air-flow rate and the water pump flow rate as control inputs, and the total power consumption of the system as the feedback signal..},
note={E6. The proposed multi-variable ESC scheme is validated with simulations, showing that it can achieve an energy saving of about 9.3{\%} compared to constant-input operation. The scheme is also shown to be robust to sensor failure and plant variation due to unknown environment changes and system degradation..},
note={E7. The multi-variable ESC control strategy is tested on a dynamic simulation model of the hybrid GSHP system developed by utilizing the Modelica Buildings Library and TIL Library.},
note={E8. This study indicates significant potential for ESC to achieve good energy efficiency in real time with a model-free advantage.},
note={E9. Objectives.},
note={E10. The objective of the study is to develop a self-optimizing control scheme for efficient operation of hybrid GSHP systems,. The study aims to address the issue of heat accumulation in the ground in cooling-dominated buildings,..},
note={E11. Methods.},
note={E12. The study uses a Modelica-based dynamic simulation model to evaluate the proposed control strategy,. The model includes a ground heat exchanger (GHE) model, which is adopted from the Modelica Buildings Library,..},
note={E13. The study uses Dymola 2014, Modelica Buildings Library 1.5, and TIL Library 3.1.0 to develop the dynamic simulation model of the hybrid GSHP system. The ESC scheme is designed using a multi-variable ESC design, which follows the guidelines provided in Ref. [42] [27]..},
note={E14. The study uses a dynamic simulation model of the hybrid GSHP system, developed using the Modelica Buildings Library and TIL Library. The model includes a transient heat conduction model of the vertical ground heat exchanger, a static polynomial cooling tower model, and a heat pump model. The multi-variable ESC scheme is designed and implemented using a two-input ESC framework, with the control inputs being the cooling-tower fan relative air-flow rate and the water pump flow rate..},
note={E15. Results.},
note={E16. The simulation results show that the proposed ESC strategy effectively achieves nearly optimal efficiency without the need for a plant model,. The results also demonstrate that the ESC scheme can optimize the control inputs for each channel in real-time, without relying on the accurate model of the system,..},
note={E17. The study presents the results of the ESC simulation under a fixed cooling load condition, which shows the trajectories of the superheat and expansion valve opening. The results demonstrate the effectiveness of the proposed ESC scheme in optimizing the system's performance..},
note={E18. Conclusions.},
note={E19. The study concludes that the proposed ESC scheme is an effective method for achieving efficient operation of hybrid GSHP systems,. The study also concludes that the ESC scheme requires minimal measurement, which can significantly reduce the cost of sensor acquisition, installation, and maintenance,..},
note={E20. The study concludes that the proposed multi-variable ESC scheme is effective in optimizing the energy efficiency of a hybrid GSHP system. The scheme is shown to be robust to sensor failure and plant variation, and can achieve an energy saving of about 9.3{\%} compared to constant-input operation.},
doi={10.1016/j.renene.2015.07.092},
url={https://doi.org/10.1016/j.renene.2015.07.092}
}

@Article{edwards2021optimal,
author={Edwards, K. C.
and Роса, Маттиа Де
and Finn, Donal},
title={Optimal control of fan coil battery air and water flow rates requiring minimal on-line measurements},
journal={Applied Thermal Engineering},
year={2021},
volume={198},
keywords={ground-source heat pump; Fan coil units; Buildings; optimal control; Thermal comfort; air handling unit},
abstract={Fan coil units are widely used in air-conditioning systems for heating and cooling of commercial buildings. Control - capable of achieving better operational efficiencies and at the same time, guarantying thermal comfort - is paramount in order to achieve optimal operation. The present paper presents a novel generalised control strategy, requiring only minimal input data, for optimising fan speed in order to reduce. Different control models are implemented to predict fan coil capacities and associated total power consumption. The developed strategy has been compared to fixed speed and benchmark fan speed control strategies, using both a steady state and a quasi-steady state algorithm, for various building loads. Results show average reduction in fan coil battery power consumption of 34{\%} and 43{\%} in heating and cooling mode respectively, when the optimal control is compared to fixed fan speed settings. Savings between 4.9{\%} and 9.1{\%} can be achieved by the control algorithms if compared to the benchmark fan speed control strategies.},
note={C. Highlights.},
note={C1. The building sector is responsible for about 40{\%} of the overall energy consumption and 36{\%} of CO2 emissions worldwide.},
note={C2. Fan coils Fan coil unit Ground source heat pump Heating, ventilation and air Inlet Outlet Power, KW Thermal Power, KW real, KW Temperature, ◦C Water Change in water flow rate Change in fan coil capacity conditioning studies have focused on optimal control using minimal input data for small or medium capacity Fan coil units (FCU) systems working at partial loads.},
note={C3. Due to differences in fan coil battery design, separate strategies are developed for bypass and modulated valve fan coil battery sub-systems.},
note={C4. The optimal fan speed control strategy was developed through derivation and implementation of a fan coil capacity estimation equation and a circulation pump power control model.},
note={C5. The results showed that the optimisation strategy operates effectively under a range of loads and is applicable to different system designs requiring only readily available inputs.},
note={C6. At low water flow rates, the difference between experimental and numerical data is more pronounced, especially for the low air flow setting. This is due to the greater impact of systematic errors that are commonly exhibited at the lower flow ranges of the instrumentation. These differences are always less than 10{\%}, which is considered acceptable as per ASHRAE standard [36] and other research [37,38], especially considering the simplified nature of the correlation adopted.},
note={C7. In large fan coil battery systems, such as the one examined the proposed approach has potential: (i) to ameliorate data error by using minimal instrumentation instances, (ii) to reduce associated instrument capital costs, and, (iii) to enhance system savings arising from the proposed algorithm.},
note={D. Findings.},
note={D1. The water temperature set-point must be sufficient to ensure the load delivery, while maximising heat pump performance, which is highly dependent on temperature (e.g., decreasing the supply temperature, in heating mode, from 55 ◦C to 35 ◦C can increase the SPF by up to 40{\%} [13]).},
note={D2. The minimum total power is located at a point where the rate of change in the pump power is equal to the rate of change in total fan power. In this case, by operating at the optimal combination of fan speeds, the total power consumption can be reduced by 13{\%}, 10{\%} and 30{\%}, when compared to fixed fan speeds of 1, 2 and 3 in all zones, respectively.},
note={D3. At low water flow rates, the difference between experimental and numerical data is more pronounced, especially for the low air flow setting. This is due to the greater impact of systematic errors that are commonly exhibited at the lower flow ranges of the instrumentation. These differences are always less than 10{\%}, which is considered acceptable as per ASHRAE standard [36] and other research [37,38], especially considering the simplified nature of the correlation adopted.},
note={D4. For all capacities, an average reduction in total power of 5.7{\%} and 5.9{\%} is observed when optimal fan speed control is compared with Cmin = Cmax control and design flow control, respectively.},
note={D5. The saving increases up to 29{\%} when compared to a constant fan speed setting of 3 in all zones.},
note={D6. Optimal fan speed control results in a maximum reduction in energy usage of 7.9{\%} and 9.1{\%}, when compared to Cmin = Cmax control in heating and cooling, respectively.},
note={D7. A maximum reduction of 6.3{\%} and 5.8{\%} is observed when compared to design flow control in heating and cooling, respectively.},
note={D8. On average total energy is reduced by 34{\%} when optimal fan speed control is used over maximum fan speed settings in each zone.},
note={D9. {\textbullet} Significant savings (up to 34{\%} in heating mode and up to 43{\%} in cooling mode) are reported when any of the fan speed control strategies are compared to fixed fan speed operation.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The present paper presents a novel generalised control strategy for optimising fan speed in fan coil units to reduce power consumption while maintaining thermal comfort, with results showing average reductions of 34{\%} and 43{\%} in heating and cooling modes respectively..},
note={E3. Key findings.},
note={E4. The results show average reductions in fan coil battery power consumption of 34{\%} and 43{\%} in heating and cooling modes respectively, when the optimal control is compared to fixed fan speed settings. Savings between 4.9{\%} and 9.1{\%} can be achieved by the control algorithms if compared to the benchmark fan speed control strategies..},
note={E5. The key findings include: optimal fan speed control results in minimum daily energy consumption for the bypass fan coil battery in heating mode, and savings of between 4.9{\%} and 5.4{\%} can be achieved compared to other control strategies. Additionally, significant savings of up to 34{\%} in heating mode and up to 43{\%} in cooling mode are reported when any of the fan speed control strategies are compared to fixed fan speed operation..},
note={E6. The results showed that the optimisation strategy operates effectively under a range of loads and is applicable to different system designs requiring only readily available inputs.},
note={E7. At low water flow rates, the difference between experimental and numerical data is more pronounced, especially for the low air flow setting. This is due to the greater impact of systematic errors that are commonly exhibited at the lower flow ranges of the instrumentation. These differences are always less than 10{\%}, which is considered acceptable as per ASHRAE standard [36] and other research [37,38], especially considering the simplified nature of the correlation adopted.},
note={E8. In large fan coil battery systems, such as the one examined the proposed approach has potential: (i) to ameliorate data error by using minimal instrumentation instances, (ii) to reduce associated instrument capital costs, and, (iii) to enhance system savings arising from the proposed algorithm.},
note={E9. Objectives.},
note={E10. The objective of the study is to develop and test a novel generalised control strategy for minimising power consumption of a fan coil battery at part load, requiring only minimal available input data. The goal is to maintain the operation within the zone temperature set-points and bandwidth while reducing power consumption..},
note={E11. Methods.},
note={E12. The study uses a combination of simulation models and experimental data to develop and test the control strategy. The control strategy is based on a new correlation exploiting minimal data set, including water and air inlet temperatures and available fan coil battery nominal design data. The strategy is implemented in a simulation model to characterise the fan coil battery of a ground-source heat pump (GSHP) system..},
note={E13. The methods used include steady state and quasi-steady state analyses of the control strategies, and the development of a fan coil capacity estimation equation and a circulation pump power control model..},
note={E14. Results.},
note={E15. The results show that the optimisation strategy operates effectively under a range of loads and is applicable to different system designs requiring only readily available inputs. Optimal fan speed control results in the minimum daily energy consumption for the bypass fan coil battery in heating mode. The comparison between the estimated fan coil capacity and the measured capacity of the fan coil unit shows a good performance of the correlations for all air flow setting points at higher water flow rates..},
note={E16. The results show that the optimization strategy operates effectively under a range of loads and is applicable to different system designs, and that significant energy savings can be achieved compared to other control strategies..},
note={E17. Conclusions.},
note={E18. The study concludes that the developed control strategy is effective in reducing power consumption while maintaining thermal comfort. The strategy has the potential to be adapted to different system designs where fan coil batteries are used as emitters. The use of minimal input data reduces the probability of malfunctioning instrumentation and associated data errors..},
note={E19. The conclusions drawn from the study are that the proposed control strategy is effective in optimizing fan coil battery performance, and that significant energy savings can be achieved compared to other control strategies.},
doi={10.1016/j.applthermaleng.2021.117469},
url={https://doi.org/10.1016/j.applthermaleng.2021.117469}
}

@Article{li2024field,
author={Li, Yiming
and Qian, Suxin},
title={Field test of a ground-source heat pump system and numerical investigation on advanced control strategies},
journal={Applied Thermal Engineering},
year={2024},
volume={246},
keywords={Heat pumps; Ground source heat pump; water pump; Control strategy; field test; TRNSYS},
abstract={Ground source heat pump (GSHP) systems have been widely studied for space heating in recent years. Aiming at reducing the power consumption of GSHP, this study focuses on leveraging advanced load-predictive control strategies to minimize unnecessary power consumption in circulating pumps under variable load operation. Taking a GSHP system in an office building as a typical case, a field test was conducted and the heating performance in 2023 was obtained. By comparing measured data with the rated performance, the limitations of the existing control strategy were identified. To investigate the energy-saving potential of new control strategies, a transient GSHP simulation model was developed in TRNSYS. Based on the experimentally validated model, two load-predictive control strategies were numerically studied. By modulating the flow rate and supply water temperature, the two advanced control strategies can achieve energy-saving of 9.9{\%} and 11.0{\%}, respectively.},
note={C. Highlights.},
note={C1. For simplicity and reduced cost, many traditional Ground source heat pump (GSHP) systems operate at constant flow rates and constant supply water temperature, which are determined under the rated full load condition [13].},
note={C2. This paper investigated a typical GSHP system by analyzing the field test results and revealing the performance limitations of its current control strategy.},
note={C3. The results of this study are summarized as follows: 1. Field test results indicated that the GSHP system operated stably.},
note={C4. For the baseline CCS control strategy, due to the constant flow rates, the input power of water pumps was around 10 kW. These results indicated that lowering the supply water temperature caused an increase in the COP from 3.5 to 4.5.},
note={C5. 2. A GSHP system simulation model was established in TRNSYS, and its accuracy was validated using the measured data.},
note={D. Findings.},
note={D1. More than 30 {\%} of the global energy consumption is attributed to buildings [3], with heating, ventilation, and air conditioning systems accounting for about 65 {\%} of this energy use in China [4].},
note={D2. Pipeline heat loss accounted for over 50 {\%} of the total heat absorbed from the soil.},
note={D3. CCS featured the lowest load-side WP energy consumption at 70.65 kW⋅h, which was half of VCS and 60 {\%} lower than VVS.},
note={D4. Meanwhile, the difference in daily energy consumption of the HP and source-side water pump was less than 1 {\%}.},
note={D5. Compared to CCS, VCS showed a 5.2 {\%} increase in total daily energy consumption.},
note={D6. On the other hand, although VVS had a lower energy consumption in the load-side water pump than VCS, the total daily energy consumption of VVS was also 3.9 {\%} higher than CCS.},
note={D7. VCS and VVS reduced daily energy consumption by 18.8 {\%} and 20.4 {\%} compared to CCS, respectively.},
note={D8. Compared to the baseline control strategy CCS, VCS achieved a 9.9 {\%} reduction, primarily due to the source-side water pump.},
note={D9. Based on this, two load-predictive control strategies were proposed, VCS and VVS, and demonstrated more than 10 {\%} energy saving from the baseline control strategy.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The study investigates the energy-saving potential of advanced control strategies for a ground source heat pump (GSHP) system in an office building, finding that two proposed control strategies, VCS and VVS, can achieve energy savings of 9.9{\%} and 11.0{\%}, respectively, compared to the baseline control strategy..},
note={E3. Key findings.},
note={E4. The study reveals that the existing control strategy of the GSHP system has limitations, and two advanced control strategies based on load prediction can achieve energy-saving of 9.9{\%} and 11.0{\%}, respectively. The study also highlights the importance of load prediction in achieving quantitative modulation of flow rate and supply water temperature..},
note={E5. The key findings of the study include the development of two new control strategies, VCS (Variable flow rate, Constant temperature Strategy) and VVS (Variable flow rate, Variable temperature Strategy), which can improve the energy efficiency of the GSHP system compared to the traditional CCS (Constant flow rate, Constant temperature Strategy). The study also found that the optimal supply water temperature varies depending on the building load, and that modulating the supply water temperature and flow rate can lead to significant energy savings..},
note={E6. The study found that pipeline heat loss accounted for over 50{\%} of the total heat absorbed from the soil, and that modulating supply water temperature based on load variations can improve system performance and energy efficiency. The study also found that the system operated more efficiently when the load was stable, and that the coefficient of performance (COP) increased when the supply water temperature was lowered..},
note={E7. For the baseline CCS control strategy, due to the constant flow rates, the input power of water pumps was around 10 kW. These results indicated that lowering the supply water temperature caused an increase in the COP from 3.5 to 4.5.},
note={E8. 2. A GSHP system simulation model was established in TRNSYS, and its accuracy was validated using the measured data.},
note={E9. Objectives.},
note={E10. The objectives of the study are to analyze the performance of the GSHP system, develop and evaluate new control strategies to improve its energy efficiency, and provide reference data for the GSHP community. The study aims to maximize energy efficiency and reduce operational costs while ensuring user thermal comfort..},
note={E11. Methods.},
note={E12. The study conducts a field test of the GSHP system and develops a transient simulation model using TRNSYS. The study also proposes two advanced control strategies based on load prediction, which adjust the flow rates and the supply water temperature of the heat pump..},
note={E13. The methods used in the study include field measurements of the GSHP system's performance, development of simulation models using TRNSYS, and analysis of the measured and simulated data. The study also involves the development of new control strategies, VCS and VVS, and their evaluation using the simulation model..},
note={E14. The study used field test data and simulation models to analyze the performance of the GSHP system. The study also used pressure-enthalpy diagrams to analyze the refrigeration cycle..},
note={E15. The study uses a combination of field testing and numerical simulation to investigate the GSHP system. The simulation model is developed in TRNSYS and validated using measured data. The study also uses numerical investigations to evaluate the energy-saving potential of the proposed control strategies..},
note={E16. Results.},
note={E17. The study reveals that the two advanced control strategies can achieve energy-saving of 9.9{\%} and 11.0{\%}, respectively. The study also shows that the existing control strategy of the GSHP system has limitations, and the proposed control strategies can improve the system's energy efficiency..},
note={E18. The results of the study show that the GSHP system's performance can be improved by using the new control strategies, VCS and VVS, which can reduce energy consumption and improve thermal comfort. The study also found that the optimal supply water temperature varies depending on the building load, and that modulating the supply water temperature and flow rate can lead to significant energy savings..},
note={E19. The study found that the GSHP system operated efficiently when the supply water temperature was lowered, and that the COP increased when the load was stable. The study also found that the simulation model had some errors compared to the field test data, particularly in predicting the load and source-side temperatures..},
note={E20. Conclusions.},
note={E21. The study concludes that advanced load-predictive control strategies can improve the energy efficiency of GSHP systems. The study also highlights the importance of load prediction in achieving quantitative modulation of flow rate and supply water temperature..},
note={E22. The conclusions of the study are that the new control strategies, VCS and VVS, can improve the energy efficiency of the GSHP system, and that the optimal supply water temperature varies depending on the building load. The study also concludes that modulating the supply water temperature and flow rate can lead to significant energy savings..},
note={E23. The study concluded that modulating supply water temperature based on load variations is necessary for energy conservation, and that pipeline heat loss should be considered in the design and operation of GSHP systems. The study also highlighted the importance of accurate simulation models in predicting the performance of GSHP systems..},
note={E24. The study concludes that the proposed control strategies, VCS and VVS, are effective in achieving energy savings for a GSHP system. The study also highlights the importance of considering the location and load profile when evaluating the energy-saving potential of control strategies.},
doi={10.1016/j.applthermaleng.2024.123008},
url={https://doi.org/10.1016/j.applthermaleng.2024.123008}
}

@Article{somogyi2016scientific,
author={Somogyi, Viola
and Sebesty{\'e}n, Viktor
and Nagy, Georgina},
title={Scientific achievements and regulation of shallow geothermal systems in six European countries -- A review},
journal={Renewable and Sustainable Energy Reviews},
year={2016},
volume={68},
keywords={Borehole Heat Exchangers; GSHP; Ground source heat pump; ground heat exchanger; Minimum distance; Groundwater heat pump; Legislation},
abstract={A legislative framework is suggested on a European Union level that gives a unified definition of shallow geothermal systems, preferably on enthalpy basis, and lays down the principles of permitting process and criteria for sustainable GHP systems based on scientific results tolerating differences due to local geological and hydrogeological properties. A clear distinction of low-risk systems is desirable to aid the simplification of administrative procedure.},
note={B. Participants: 1993 papers.},
note={B1. The algorithm filters those articles by countries, in which the terms ``heat pump'' and ``geothermal'' or ``ground source'' are included. In January 2015, all in all, 1,993 papers were found. The repeated investigation in October 2015 gave 2648 results without the articles published in 2016.},
note={C. Highlights.},
note={C1. It has to be noted that not all articles that were found relevant are cited : the focus was placed on ground source heat pumps and groundwater heat pumps.},
note={C2. A major conclusion of reviewing both the scientific literature and the legislation of different countries is that the regulations do not take advantage of the researches or at least there is a lag in implementation.},
note={C3. There are some good examples found online such as the ThermoMap project for very shallow geothermal energy and the GSHP screening tool to assess viability of open-loop (4100 kW) systems for England and Wales.},
note={C4. The definition of shallow geothermal energy differs; Italy uses temperature categories, while other countries set the boundaries based on different depths.},
note={C5. Under the conditions typical for European Mediterranean area the GSHP was proven to use 37 718{\%} primary energy of a conventional air to water heat pump system in cooling mode in Valencia  while in Almer{\'{\i}}a 31{\%} less electrical energy was used compared to the cooling tower system on site, saving 116 m3 water throughout the summer period.},
note={C6. The authors suggest a legislative framework on a transnational level that sets the definition of shallow geothermal systems, the principles of permitting process and criteria for permissible GHP systems based on scientific results taking local geological and hydrogeological properties into consideration. This does not mean that absolute values dedicated to regions should be defined but the minimum distances and or maximum temperature differences should correlate with the characteristics of the subsurface in question.},
note={D. Findings.},
note={D1. As of 2008 0.7{\%} of GHG in Europe was saved and this could be raised up to 30{\%} with improved performance of heat pumps and use of low carbon electricity [107].},
note={D2. For a system of 25 BHEs the temperature change was 18{\%} less by optimizing the load of the individual boreholes [120].},
note={D3. Under the conditions typical for European Mediterranean area the GSHP was proven to use 37 718{\%} primary energy of a conventional air to water heat pump system in cooling mode in Valencia [151] while in Almer{\'{\i}}a 31{\%} less electrical energy was used compared to the cooling tower system on site, also saving 116 m3 water throughout the summer period [152].},
note={D4. In situ optimization method was developed for the water circulation pumps of a single stage heat pump unit and a system of two compressors working in tandem resulting in 28{\%} [156] and 31{\%} [157] of energy saving respectively. This was later improved to ensure user comfort along with 33{\%} energy saving potential [158].},
note={D5. Based on numerical modelling of two typical house types the combined impact of low performance for light load periods of thermostatically-controlled GSHPs and heating system over-sizing (by up to 40{\%}) increases energy use by up to 18--22{\%} [191].},
note={D6. Concerning life cycle impacts a study found that heat pumps (SPF 3.9) are advantageous considering only global warming potential, depletion of fossil resources and formation of photochemical oxidants, natural gas boilers being the benchmark while other indicators were 68{\%} higher on average [196], contrary to other researches.},
note={D7. Two versions of GSHP with on/off control and electrical auxiliary heating was compared to variable capacity system and the results showed that if the GSHP is designed to cover more than 65{\%} of the peak heat demand of the building the SPF is around the same but below 55{\%} the SPF is around 13{\%} lower as the one of the variable speed system [260].},
note={D8. The heat pumps can be certified, besides fulfilling other criteria, if the hydraulic layout of the ground loop system is such that the overall pumping power at the lowest operating temperature is less than 3{\%} of the heating capacity.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The article discusses the need for a unified legislative framework on a European Union level for shallow geothermal systems, providing a definition, permitting process, and criteria for sustainable systems based on scientific results, considering local geological and hydrogeological properties..},
note={E3. Key findings.},
note={E4. The study found that the regulations in different countries do not take advantage of research results, and there is a lag in implementation. The definition of shallow geothermal energy differs among countries, with Italy using temperature categories and other countries setting boundaries based on different depths. The study also found that open-loop systems are less preferred due to higher environmental risks and stricter licensing rules..},
note={E5. Objectives.},
note={E6. The objective of the study is to review the recent scientific literature concerning geothermal heat pumps and existing regulations in selected European countries. The study aims to provide information on the research concerning shallow geothermal energy and its sustainable utilization in the selected countries of the European Union..},
note={E7. The authors suggest a legislative framework on a transnational level that sets the definition of shallow geothermal systems, the principles of permitting process and criteria for permissible GHP systems based on scientific results taking local geological and hydrogeological properties into consideration. This does not mean that absolute values dedicated to regions should be defined but the minimum distances and or maximum temperature differences should correlate with the characteristics of the subsurface in question.},
note={E8. Objectives.},
note={E9. The objective is to create a guideline for designing geothermal heat pumps that can be applied in different climatic and hydrogeological situations..},
note={E10. Methods.},
note={E11. The research group used a database search to find relevant articles, using search phrases and the names of countries in the affiliation field. The search was performed in January 2015 and repeated in October 2015 to update the results. The research group categorized the papers by country to allow comparison with national legislation..},
note={E12. Results.},
note={E13. The study found that the majority of research dealt with performance issues and means of obtaining information on operation and its effects on short and long time-scales. The study also found that modeling approaches are more dominant, as measurements may be problematic in subsurface cases. Environmental aspects are less emphasized, with benefits highlighted, although Italian authors prepared several articles on thermal affected zones..},
note={E14. Conclusions.},
note={E15. The study concludes that regulations do not take advantage of research results, and there is a lag in implementation. The study suggests a legislative framework on a transnational level that sets the definition of shallow geothermal systems, principles of permitting process, and criteria for permissible GHP systems based on scientific results..},
note={E16. The conclusion is that a flexible and systematic guideline is necessary for the effective design and application of geothermal heat pumps in various situations.},
doi={10.1016/j.rser.2016.02.014},
url={https://doi.org/10.1016/j.rser.2016.02.014}
}

@Article{atam2015design,
author={Atam, Ercan
and Helsen, Lieve},
title={Ground-coupled heat pumps: Part 2---Literature review and research challenges in optimal design},
journal={Renewable and Sustainable Energy Reviews},
year={2015},
volume={54},
keywords={borehole heat exchangers; Optimal design; Reynolds number; Co-design; literature review; state space model; Artificial Neural Network},
abstract={This paper is the second part of the paper on literature review and challenges in modelling and optimal control/optimal design of Ground-Coupled Heat Pump (GCHP) systems. The first part was ``GroundCoupled Heat Pumps: Part 1---Literature Review and Research Challenges in Modelling and Optimal Control''. In this second part, a detailed literature review of optimal design of GCHP systems and the associated research challenges are given. Since optimal design may require a model, a very short summary of modelling approaches is also given. More details on modelling and on research challenges can be found in the first part and hence these details will not be repeated here. As in the first part, we adopt the adage ``a picture is worth a thousand words'' and include a minimal number of representative schematics and result figures for some of the reviewed studies for clarity and a better understanding of the presented material. In addition to the literature review, we included our comments, points of view, alternative solutions and some potential future directions. This review paper is useful both for engineers and researchers involved in optimal design of GCHP systems.},
note={B. Participants: 3 closely related studies.},
note={B1. Optimal sizing based on computational heat transfer approaches. In this category, we will review three closely related studies. The first one is the work of Gultekin et al [31], where a numerical approach to optimize the distance between boreholes for a set of borefield configurations as shown in Fig. 4(a) was considered.},
note={C. Highlights.},
note={C1. Future worries on finite fossil energy resources and necessity of environmental friendliness have made renewable energy use popular and widespread in recent years.},
note={C2. Mathematical model based optimal design or co-design depends on an accurate mathematical model of the underlying borefield subsystem and other subcomponents of a Ground-Coupled Heat Pump (GCHP) or Hybrid Ground-Coupled Heat Pump (HyGCHP) system.},
note={C3. The bottleneck here is borefield modelling to predict the thermal behaviour of a general borefield system accounting for the thermal interaction between boreholes, the effect of groundwater flow, the effect of a dynamic ground surface boundary condition, multi-layer ground characteristics, combination of short-term and longterm effects, etc.},
note={C4. Thermal response factor models and statespace models can be used for borefield modelling.},
note={C5. Thermal response factor models can be used in approaches based on rules of thumb and state-space models can be used in a numerical optimization approach.},
note={C6. A nice and interesting exercise would be to compare different categories of optimal design, and if possible co-design, on a benchmark case to have an idea of the comparative performances of the different approaches presented.},
note={D. Findings.},
note={D1. The results are shown in Fig. 15(b) as a comparison to the normal grid with equal distributed BHE loads. They observed that the optimization based on load optimization leads to a relative improvement of 30{\%} compared to the reference case.},
note={D2. Mass flow rate (kg/s) load ratio and to the configuration of the borefield. At the end, they claimed that the use of GLHEPro results in an over-sized borefield with a 35{\%} higher total cost.},
note={D3. Compared to Yavuzturk and Spitler [30], they achieved an improvement of 17{\%} in life cycle cost, 10{\%} in annual energy usage but 7{\%} increase in total investment cost.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. This paper reviews the literature on optimal design of Ground-Coupled Heat Pump (GCHP) systems, discussing the challenges and approaches to modelling and optimal control, and highlighting the need for intensified research on mathematical models and numerical optimization schemes..},
note={E3. Key findings.},
note={E4. The key findings of the study include the importance of accurate mathematical modelling of the borefield subsystem and other subcomponents of GCHP systems. The study also highlights the challenges of borefield modelling, including the thermal interaction between boreholes, groundwater flow, and dynamic ground surface boundary conditions..},
note={E5. The bottleneck here is borefield modelling to predict the thermal behaviour of a general borefield system accounting for the thermal interaction between boreholes, the effect of groundwater flow, the effect of a dynamic ground surface boundary condition, multi-layer ground characteristics, combination of short-term and longterm effects, etc.},
note={E6. Thermal response factor models and statespace models can be used for borefield modelling.},
note={E7. Thermal response factor models can be used in approaches based on rules of thumb and state-space models can be used in a numerical optimization approach.},
note={E8. A nice and interesting exercise would be to compare different categories of optimal design, and if possible co-design, on a benchmark case to have an idea of the comparative performances of the different approaches presented.},
note={E9. Objectives.},
note={E10. The objectives of the study are to review the literature on optimal design of GCHP systems, identify the challenges and approaches to modelling and optimal control, and highlight the need for future research. The study aims to provide a comprehensive overview of the current state of knowledge in the field..},
note={E11. Methods.},
note={E12. The study uses a literature review approach, examining the existing research on optimal design of GCHP systems. The study also considers the use of mathematical models, numerical optimization schemes, and artificial neural networks (ANNs) for optimal design and control..},
note={E13. Results.},
note={E14. The results of the study show that the co-design approach is the best strategy for achieving optimal global system performance. The study also finds that rule/chart-based optimal design is currently the dominant approach, but intensified research on mathematical models and numerical optimization schemes is expected in the near future..},
note={E15. Conclusions.},
note={E16. The conclusions of the study highlight the importance of accurate mathematical modelling of GCHP systems and the need for future research on optimal design and control. The study also emphasizes the challenges of borefield modelling and the need for generic approaches that can be applied to complex borefield systems.},
doi={10.1016/j.rser.2015.07.009},
url={https://doi.org/10.1016/j.rser.2015.07.009}
}

@Article{atam2015ground,
author={Atam, Ercan
and Helsen, Lieve},
title={Ground-coupled heat pumps: Part 1 -- Literature review and research challenges in modeling and optimal control},
journal={Renewable and Sustainable Energy Reviews},
year={2015},
volume={54},
keywords={Optimal control; Artificial Neural Networks; state space model; dynamics},
abstract={In this paper, a compact overview of the state-of-the-art in modeling of ground-coupled heat pump (GCHP) systems and an in-depth review of their optimal control along with the associated research challenges are given. The main focus is on optimal control but since design of an optimal controller may require a model, a relatively short literature review of modeling approaches is also discussed. Adopting the adage ``a picture is worth a thousand words'', we tried to include a minimal number of representative schematics and result figures for some of the reviewed studies for clarity and a better understanding of the presented material. In addition to the literature review, we included our comments, points of view, alternative solutions and some potential future directions. This review paper is useful both for engineers and researchers involved in modeling and optimal control of GCHP systems. The second part of the paper, ``Ground-Coupled Heat Pumps: Part 2 -- Literature Review and Research Challenges in Optimal Design'', focuses on the literature review on optimal design and the associated design challenges for GCHP systems.},
note={C. Highlights.},
note={C1. Despite the low public awareness of this energy-efficient technology based on geothermal energy sources, ground-coupled heat pump (GCHP) have been in commercial use for more than 50 years.},
note={C2. Atam and Helsen [57] presented a convex approach through convexification for non-convex optimal control-based and nonconvex model predictive control-based energy-use minimization of buildings equipped with hybrid ground-coupled heat pump systems.},
note={C3. Mathematical model-based optimal control depends on an accurate mathematical control model of the underlying borefield subsystem and other subcomponents of a GCHP or hybrid ground-coupled heat pump (HyGCHP) system.},
note={C4. The bottleneck here is control-oriented borefield modeling to predict the thermal behavior of a general borefield system accounting for the thermal interaction between boreholes, the effect of groundwater flow, the effect of a dynamic ground surface boundary condition, multi-layer ground characteristics, combination of short-term and long-term effects, etc.},
note={C5. Thermal response factor models and statespace models can be used for borefield modeling.},
note={C6. The energy saving performance of MPC was 1--3{\%} better compared to the conventional controller, which increased to 7.5{\%} when night setback was considered.},
note={C7. In general, Artificial Neural Networks (ANNs) models are not appropriate to design a controller to work in a long time period of 15--20 years (typical for (Hy)GCHPs).},
note={D. Findings.},
note={D1. In Fig. 5, the ESC controller is tuned at t 1{\textfractionssolidus}4 50; 000 s and the ESC controller achieves the estimated optima in the static maps, with steady-state errors less than 3{\%} in both cases.},
note={D2. The results showed that the performance of MPC and linear optimal controllers were close to dynamic programming-based control results: less than 10{\%} performance deterioration.},
note={D3. Without night setback, the energy saving performance of MPC was 1--3{\%} better compared to the conventional controller, which increased to 7.5{\%} when night setback was considered.},
note={D4. On the other hand, if the fixed capacity GCHP is designed to cover more than 65{\%} of peak building load, then SPFs are close to each other.},
note={D5. The fixed capacity GCHP systems have a higher SPF when the auxiliary heater is designed to cover less than 5{\%} of the annual heat demand.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. The optimal control of hybrid ground-coupled heat pump (HyGCHP) systems is a complex task that requires accurate mathematical models and advanced control strategies, with various approaches having been proposed in the literature, including model predictive control, extremum seeking control, and convex optimization..},
note={E3. Key findings.},
note={E4. The key findings of the study include the importance of accurate modeling of GCHP systems for optimal control, the challenges in obtaining an accurate model of a borefield, and the need for intelligent control strategies to determine quantitative values of optimal load sharing between components. The study also highlights the usefulness of mathematical model-based control approaches, particularly those using linear-time invariant state-space models..},
note={E5. The bottleneck here is control-oriented borefield modeling to predict the thermal behavior of a general borefield system accounting for the thermal interaction between boreholes, the effect of groundwater flow, the effect of a dynamic ground surface boundary condition, multi-layer ground characteristics, combination of short-term and long-term effects, etc.},
note={E6. Thermal response factor models and statespace models can be used for borefield modeling.},
note={E7. The energy saving performance of MPC was 1--3{\%} better compared to the conventional controller, which increased to 7.5{\%} when night setback was considered.},
note={E8. In general, Artificial Neural Networks (ANNs) models are not appropriate to design a controller to work in a long time period of 15--20 years (typical for (Hy)GCHPs).},
note={E9. Objectives.},
note={E10. The objectives of the study are to provide a comprehensive review of the state-of-the-art in modeling and optimal control of GCHP systems, to highlight the challenges and opportunities in this field, and to suggest future directions for research. The study aims to provide a useful resource for engineers and researchers involved in modeling and optimal control of GCHP systems..},
note={E11. Methods.},
note={E12. The methods used in the study include a literature review of modeling approaches for GCHP systems, a review of optimal control strategies for GCHP systems, and an analysis of the challenges and opportunities in this field. The study also uses numerical approaches, such as dynamic programming, to evaluate the performance of different control strategies..},
note={E13. Results.},
note={E14. The results of the study show that mathematical model-based control approaches are the most useful and preferable ones for optimal control of GCHP systems. The study also shows that the performance of model predictive control (MPC) and linear optimal controllers are close to dynamic programming-based control results, with less than 10{\%} performance deterioration..},
note={E15. Conclusions.},
note={E16. The conclusions of the study are that accurate modeling of GCHP systems is essential for optimal control, and that mathematical model-based control approaches are the most useful and preferable ones for optimal control of GCHP systems. The study also concludes that there are still challenges and opportunities in this field, and that further research is needed to develop more accurate models and control strategies..},
note={E17. The conclusions of the study highlight the importance of accurate mathematical models and advanced control strategies for optimal control of HyGCHP systems, and identify the challenges and limitations of current control methods, including the need for more accurate borefield modeling and the development of generic approaches.},
doi={10.1016/j.rser.2015.10.007},
url={https://doi.org/10.1016/j.rser.2015.10.007}
}

@Article{ma2020recent,
author={Ma, Zhenjun
and Xia, Lei
and Gong, Xuemei
and Kokogiannakis, Georgios
and Wang, Shugang
and Zhou, Xinlei},
title={Recent advances and development in optimal design and control of ground source heat pump systems},
journal={Renewable and Sustainable Energy Reviews},
year={2020},
volume={131},
keywords={Ground source heat pump; GSHP; multi-objective optimization; Sensitivity analysis; Review; genetic algorithms; Optimal control},
abstract={Ground source heat pump (GSHP) systems have attracted wide attention in developing energy-efficient buildings. Considering the high upfront cost of GSHP systems, appropriate design and control optimization are essential to enhancing their energy efficiency and reducing the payback period. Since there are many variables influencing the performance of GSHP systems, the commonly used rule-based approaches cannot ensure that the system is designed and operated in an optimal manner. This paper presents an overview of recent advances and development in optimal design and control of GSHP systems, aiming to provide some concluding remarks and recommendations for future research in this direction. The general optimization problems for optimal design and control of GSHP systems are first presented. Sensitivity analysis to determine the major variables to formulate the optimization problems is then discussed. Furthermore, recent progress in optimal design and control of GSHP systems is reviewed. The results showed that an increasing number of single-objective and multi-objective design optimization strategies for GSHP systems have been developed, which seems more robust than commonly used rule-based design approaches. It was shown that optimal control can provide a better operating performance of GSHP systems as compared to rule-based control methods. The majority of studies used a model-based approach to formulate the control problem and model predictive control could play an essential role in renewable integrated GSHP systems. However, studies on optimal control of GSHP systems are insufficient and development of energy-efficient control strategies and evaluation of their control reliability, effectiveness and long-term performance are needed.},
note={C. Highlights.},
note={C1. Primary energy shortage, increasing energy demand, and global warming are among the major worldwide challenges [1].},
note={C2. This paper aims to provide recent progress and advances in the research work carried out on design optimization and optimal control of Ground source heat pump (GSHP) systems.},
note={C3. Robert and Gosselin [31], for instance, used the half-normal plot method to study the variation of the design variable on the impact of the total cost of a GSHP system and it was shown that the borehole number and depth were the two main parameters.},
note={C4. The results demonstrated the importance of varying water flow rates in GSHP systems for improved energy efficiency.},
note={C5. The results showed that the nonlinear model predictive control (MPC) exhibited a better performance than the other two strategies when all the factors such as applicability, and savings in annual cost were taken into account simutaneously.},
note={C6. To solve soil temperature fluctuation, performance analysis for the first 10 years is important during the design. 17{\%} decrease in total present value cost, 10{\%} decrease in annual energy use, and a 7{\%} increase in total initial cost as compared with the results from another study.},
note={C7. This work discussed the general issues related to the optimization of GSHP systems and provided an overview of recent progress and.},
note={D. Findings.},
note={D1. Buildings are the major energy users and consume more than 30{\%} of global energy usage [2], among which a significant proportion is used for heating, ventilation, and air-conditioning (HVAC) [3].},
note={D2. The optimal design can reduce the EGN of 12.2{\%} and the total system cost of 5.5{\%}, compared to a base design case.},
note={D3. Optimization can decrease the 20-year LCC of the system by more than 10{\%} in comparison to baseline design cases.},
note={D4. The COP of this hybrid GSHP optimized using the utility concept was 4.23, 8.74{\%} higher than that optimized using the Taguchi method.},
note={D5. To solve soil temperature fluctuation, performance analysis for the first 10 years is important during the design. 17{\%} decrease in total present value cost, 10{\%} decrease in annual energy use, and a 7{\%} increase in total initial cost as compared with the results from another study.},
note={D6. The GSHP in the hybrid system can usually meet more than 80{\%} of the total annual heating and cooling demand of buildings through optimization.},
note={D7. Optimization can lead to 16.7{\%} improvement in heat pump performance and 11.8{\%} decrease in annual cost.},
note={D8. It was shown that there was no significant difference if the on/off controlled GSHP can cover more than 65{\%} of the building peak heating demand.},
note={D9. Compared to the original design, the entropy generation rate decreased by 25.6{\%} while the integrated evaluation factor increased by 15.3{\%}.},
note={D10. The use of GRG2 as the optimization tool provided a more stable optimal solution and the new method can save the total annual cost of more than 10{\%}.},
note={D11. A reduction in annual power consumption of 28{\%} was achieved, compared to the nominal frequency operation.},
note={D12. The strategy can result in a reduction in cooling power consumption of 4.2{\%}, as compared to a two-stage control strategy.},
note={D13. The strategy can result in a reduction in cooling power consumption of 4.2{\%}, as compared to a two-stage control strategy. It can reduce the cooling and heating power consumption of 9.0{\%} and 8.0{\%} respectively, as compared to a rule-based strategy. This strategy can reduce the total system energy consumption of 4.15{\%}, as compared to a baseline strategy.},
note={D14. It can reduce the cooling and heating power consumption of 9.0{\%} and 8.0{\%} respectively, as compared to a rule-based strategy. This strategy can reduce the total system energy consumption of 4.15{\%}, as compared to a baseline strategy. This strategy can save up to 18{\%} energy as compared to the conventional control strategies.},
note={D15. An increase in the seasonal system performance of over 20{\%} in heating and 40{\%} in cooling can be achieved, as compared to the nominal frequency operation.},
note={D16. The new strategy can increase the seasonal performance factor of 33{\%}, as compared to another control strategy.},
note={D17. This strategy can save 9.3{\%} energy consumption, as compared to that using constant settings. This strategy can save 18.3{\%} energy in comparison to an on/off control strategy. This strategy can save 7.8{\%} and 7.1{\%} energy and generate 4.4{\%} and 6.2{\%} more electricity in the cooling and heating operations, compared to a baseline strategy.},
note={D18. The strategy can reduce the operational cost by 12.56{\%} based on seven days test, compared to the empirical operation.},
note={D19. This strategy can reduce the operational cost by 7.8{\%} in the coldest month, compared to a conventional set-point controller.},
note={D20. The strategy can reduce gas consumption by 23{\%}, compared to the existing control strategy.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. This paper provides an overview of recent advances and developments in optimal design and control of Ground Source Heat Pump (GSHP) systems, highlighting the need for optimization to enhance energy efficiency and reduce payback periods..},
note={E3. Key findings.},
note={E4. The results show that single-objective and multi-objective design optimization strategies for GSHP systems have been developed, which are more robust than commonly used rule-based design approaches, and that optimal control can provide better operating performance of GSHP systems..},
note={E5. The results demonstrated the importance of varying water flow rates in GSHP systems for improved energy efficiency.},
note={E6. The results showed that the nonlinear model predictive control (MPC) exhibited a better performance than the other two strategies when all the factors such as applicability, and savings in annual cost were taken into account simutaneously.},
note={E7. To solve soil temperature fluctuation, performance analysis for the first 10 years is important during the design. 17{\%} decrease in total present value cost, 10{\%} decrease in annual energy use, and a 7{\%} increase in total initial cost as compared with the results from another study.},
note={E8. This work discussed the general issues related to the optimization of GSHP systems and provided an overview of recent progress and.},
note={E9. Objectives.},
note={E10. The main objectives of the study are to define appropriate optimization objectives, identify key variables to be optimized, formulate the optimization problem, and solve the optimization problem using an appropriate method..},
note={E11. Methods.},
note={E12. The study uses a model-based approach to formulate the control problem, and model predictive control is identified as a key method for optimizing GSHP systems..},
note={E13. Results.},
note={E14. The results demonstrate the importance of varying water flow rates in GSHP systems for improved energy efficiency, and that nonlinear model predictive control exhibits better performance than other strategies..},
note={E15. Conclusions.},
note={E16. The study concludes that optimal design and control of GSHP systems are essential to enhance energy efficiency and reduce payback periods, and that further research is needed to develop energy-efficient control strategies and evaluate their control reliability, effectiveness, and long-term performance.},
doi={10.1016/j.rser.2020.110001},
url={https://doi.org/10.1016/j.rser.2020.110001}
}

@Article{gao2022optimal,
author={Gao, Jiajia
and Yan, Junjun
and Xu, Xinhua
and Yan, Tian
and Huang, Gongsheng},
title={An optimal control method for small-scale GSHP-integrated air-conditioning system to improve indoor thermal environment control},
journal={Journal of Building Engineering},
year={2022},
volume={59},
keywords={ground-source heat pump; Optimal control; air-conditioning system; room temperature; temperature control},
abstract={ON/OFF controlled ground-source heat pump (GSHP) is often integrated with small-scale central air-conditioning system (ACS) for villas. Chilled-water temperature (CHWT) in this system usually oscillates in a large range due to the ON/OFF switch of the compressor. As it may be too high or too low, the cooling output of the air-handling unit (AHU) in its adjustable range may not be coincident with the indoor cooling demand, which may lead to unsatisfactory room temperature control performance. This study proposes an optimal control method for this system to improve the control robustness of the room temperature. Usually, the variation of indoor cooling-load is transferred to the chilled-water resulting in changing water temperature. In this method, the optimal chilled-water return (CHWR) temperature is calculated on the basis of the estimated sensible heat load and total cooling-load of the concerned rooms. Then, this CHWR temperature is reset following up the ON and OFF states of the compressor to regulate the variation range of the CHWT. Thus, the cooling output of the AHU in its adjustable range can always follow up the changing of indoor cooling demand. This method is tested on a simulation platform and a real ACS. The test results show good temperature control performance can be achieved. The experimental results demonstrate that the maximum deviation of room temperature is reduced by 2◦C and the energy consumption of the GSHP and fan can be reduced by 30.12{\%} at light cooling-load. The application performance shows this method can be easily realized in a common building automation system.},
note={C. Highlights.},
note={C1. Small-scale ground-source heat pump (i.e., GSHP) integrated central air-conditioning systems (i.e., ACSs) are well suited and widely used in the small-scale and low-density residential buildings, such as villas, rural houses, or some small offices [1,2,3].},
note={C2. This study presents an optimal control method for an ON/OFF controlled GSHP-integrated central air-conditioning system (i.e., ACS) so as to improve the control performance of the indoor thermal environment.},
note={C3. The chilled-water return temperature (i.e., CHWR) is optimized based on estimated cooling-load. It can regulate the cooling output capacity of the air-handling unit (AHU) following up the ON and OFF states of the GSHP to always satisfy the changing of the indoor cooling demand.},
note={C4. The control performance of this optimal control method was tested in the simulation platform of a GSHP-integrated central ACS.},
note={C5. The test results show that a better control robustness and accuracy of room temperature can be achieved by using the optimal control method in a typical summer day as well as in a typical spring day.},
note={C6. The results show that the system energy use can be reduced significantly at light load condition by using the optimal control method. In this test, the energy consumption was reduced by 30.12{\%} in total of GSHP and fan.},
note={C7. The experiment results show that the optimal control method can obtain much better room temperature control performance when comparing with the basic control method.},
note={D. Findings.},
note={D1. The experimental results demonstrate that the maximum deviation of room temperature is reduced by 2◦C and the energy consumption of the GSHP and fan can be reduced by 30.12{\%} at light cooling-load.},
note={D2. The total energy consumption of GSHP and fan can be reduced by 7.63{\%} in the spring day.},
note={D3. The results also show that the system energy use can be reduced significantly at light load condition by using the optimal control method. In this test, the energy consumption was reduced by 30.12{\%} in total of GSHP and fan.},
note={E. Summary.},
note={E1. Snapshot.},
note={E2. This study proposes an optimal control method for a small-scale ground-source heat pump (GSHP) integrated central air-conditioning system (ACS) to improve the control robustness of the room temperature, which can reduce the maximum deviation of room temperature by 2{\textdegree}C and the energy consumption of the GSHP and fan by 30.12{\%} at light cooling-load..},
note={E3. Key findings.},
note={E4. The key findings of the study include the development of an optimal control method that can calculate the optimal chilled-water return (CHWR) temperature set-point online using an AHU model according to the estimated real-time sensible heat load and total cooling-load of the concerned rooms. The study also found that the proposed control method can reduce the maximum deviation of room temperature by 2{\textdegree}C and the energy consumption of the GSHP and fan by 30.12{\%} at light cooling-load..},
note={E5. The optimal control algorithm can improve the control robustness of room temperature under different cooling-load conditions by adjusting the set-point of the chilled water return (CHWR) temperature. The algorithm uses the average sensible heat load and total cooling-load to assess the cooling-load condition and adjust the CHWR temperature set-point accordingly..},
note={E6. The key findings of the study include: (1) the optimal control method can achieve better control robustness and accuracy of room temperature, (2) the total energy consumption of GSHP and fan can be reduced by 7.63{\%} in the spring day, and (3) the system energy use can be reduced significantly at light load condition by using the optimal control method, with a reduction of 30.12{\%} in total of GSHP and fan..},
note={E7. The experiment results show that the optimal control method can obtain much better room temperature control performance when comparing with the basic control method.},
note={E8. Objectives.},
note={E9. The objective of the study is to improve the control robustness of the room temperature in a small-scale GSHP-integrated central ACS by developing an advanced optimal control method. The study aims to address the issue of unsatisfactory room temperature control performance in GSHP-integrated central ACSs..},
note={E10. Methods.},
note={E11. The study proposes an optimal control method that calculates the optimal CHWR temperature set-point online using an AHU model according to the estimated real-time sensible heat load and total cooling-load of the concerned rooms. The method is tested on a simulation platform and a real ACS..},
note={E12. The study uses a simulation platform developed by the Transient Simulation Program (TRNSYS) to validate the control performance of the optimal control method. The simulation platform includes a GSHP, a GSHE, a water pump, a water tank, and an AHU, and is used to test the optimal control algorithm under different cooling-load conditions. The algorithm uses the average sensible heat load and total cooling-load to assess the cooling-load condition and adjust the CHWR temperature set-point accordingly..},
note={E13. The study uses a simulation platform and an experimental test to evaluate the performance of the optimal control method, which involves regulating the CHWR temperature set-point based on estimated cooling-load..},
note={E14. Results.},
note={E15. The results of the study show that the proposed control method can achieve good temperature control performance. The experimental results demonstrate that the maximum deviation of room temperature is reduced by 2{\textdegree}C and the energy consumption of the GSHP and fan can be reduced by 30.12{\%} at light cooling-load..},
note={E16. The simulation results show that the optimal control algorithm can improve the control robustness of room temperature under different cooling-load conditions. The room temperature was tracked robustly and accurately, with a mean absolute tracking error of 0.07{\textdegree}C and a maximum deviation of 0.4{\textdegree}C at steady state phase. The CHWR temperature set-point was adjusted to change the variation range of the CHWR temperature for meeting the heavy cooling-load..},
note={E17. Conclusions.},
note={E18. The study concludes that the proposed optimal control method can improve the control robustness of the room temperature in a small-scale GSHP-integrated central ACS. The method can reduce the maximum deviation of room temperature and energy consumption of the GSHP and fan..},
note={E19. The study concludes that the optimal control algorithm can improve the control robustness of room temperature under different cooling-load conditions by adjusting the set-point of the CHWR temperature. The algorithm is effective in tracking the room temperature robustly and accurately, and can be used to improve the energy efficiency of GSHP-integrated ACS.},
doi={10.1016/j.jobe.2022.105140},
url={https://doi.org/10.1016/j.jobe.2022.105140}
}

